<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pedido confirmado | <%= siteSettings?.brandName || "GATON DO" %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/app.css?v=ref10c-mobilefit">
</head>
<body class="ref10-body ref10-success-page bg-[#f8f6f2] text-stone-900">
  <%- include("../partials/header") %>

  <main class="ref10-success-main max-w-4xl mx-auto px-4 py-12">
    <div class="bg-white border border-stone-200 rounded-3xl p-8 shadow-sm">
      <div class="w-16 h-16 rounded-full bg-green-100 text-green-700 flex items-center justify-center text-3xl mb-6">
        ✓
      </div>

      <p class="text-xs uppercase tracking-[0.35em] text-stone-500">Pedido confirmado</p>
      <h1 class="text-4xl font-semibold mt-2">Gracias por tu compra</h1>
      <p class="text-stone-600 mt-4">
        Tu pedido fue registrado correctamente. Pronto nos comunicaremos contigo por WhatsApp o teléfono.
      </p>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-stone-50 rounded-2xl p-5">
          <h2 class="text-xl font-semibold mb-4">Resumen</h2>
          <div class="space-y-2 text-sm">
            <div><span class="text-stone-500">Pedido:</span> <strong><%= order._id %></strong></div>
            <div><span class="text-stone-500">Cliente:</span> <strong><%= order.customerName %></strong></div>
            <div><span class="text-stone-500">Teléfono:</span> <strong><%= order.phone %></strong></div>
            <% if (order.email) { %>
              <div><span class="text-stone-500">Correo:</span> <strong><%= order.email %></strong></div>
            <% } %>
            <div><span class="text-stone-500">Envío:</span> <strong><%= order.shippingMethod %></strong></div>
            <div><span class="text-stone-500">Estado:</span> <strong class="capitalize"><%= order.status %></strong></div>
          </div>
        </div>

        <div class="bg-stone-50 rounded-2xl p-5">
          <h2 class="text-xl font-semibold mb-4">Totales</h2>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-stone-600">Subtotal</span>
              <span class="font-medium"><%= formatCurrency(order.subtotal || 0) %></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-stone-600">Envío</span>
              <span class="font-medium"><%= formatCurrency(order.shippingCost || 0) %></span>
            </div>
            <div class="pt-3 border-t border-stone-200 flex items-center justify-between">
              <span class="text-lg font-semibold">Total</span>
              <span class="text-lg font-semibold"><%= formatCurrency(order.total || 0) %></span>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <h2 class="text-2xl font-semibold mb-4">Productos</h2>
        <div class="space-y-4">
          <% order.items.forEach(item => { %>
            <div class="border border-stone-200 rounded-2xl p-4">
              <div class="font-medium text-stone-900"><%= item.productName %></div>
              <div class="text-sm text-stone-500 mt-1">Cantidad: <%= item.quantity %></div>
              <% if (item.variantLabel || item.variantOptionValue) { %>
                <div class="text-sm text-stone-500 mt-1">
                  Variante: <%= item.variantLabel || item.variantOptionValue %>
                </div>
              <% } %>
              <% if (item.customizationSummary) { %>
                <div class="text-sm text-stone-500 mt-1">
                  Personalización: <%= item.customizationSummary %>
                </div>
              <% } %>
              <% if (item.customizationPhotoUrl) { %>
                <div class="text-sm text-stone-500 mt-1">
                  Foto para fotograbado cargada. También podrás avisarlo por WhatsApp.
                </div>
              <% } %>
              <div class="text-sm text-stone-500 mt-1">
                <%= formatCurrency(item.lineTotal || 0) %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <% if (whatsappOrderUrl) { %>
          <a href="<%= whatsappOrderUrl %>" target="_blank" rel="noopener" class="rounded-xl bg-[#016B83] text-white px-6 py-3 font-medium hover:opacity-90">
            Enviar pedido por WhatsApp
          </a>
        <% } %>
        <a href="/shop" class="rounded-xl bg-stone-900 text-white px-6 py-3 font-medium hover:bg-stone-800">
          Seguir comprando
        </a>
        <a href="/" class="rounded-xl bg-white border border-stone-300 px-6 py-3 font-medium hover:bg-stone-50">
          Volver al inicio
        </a>
      </div>
    </div>
  </main>
</body>
</html>