<% const jsonForInlineScript = (value) => JSON.stringify(value).replace(/[<>&\u2028\u2029]/g, (character) => ({
  "<": "\\u003c", ">": "\\u003e", "&": "\\u0026", "\u2028": "\\u2028", "\u2029": "\\u2029"
})[character]); %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> | <%= siteSettings?.brandName || "GATON DO" %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Anton&family=Dancing+Script&family=Great+Vibes&family=Life+Savers&family=Libre+Baskerville&family=Lobster&family=Roboto+Slab&family=Satisfy&display=swap">
  <link rel="stylesheet" href="/css/app.css?v=tipografias-grabado-1">
</head>
<body class="ref10-body ref10-product-page">
  <%- include("../partials/header") %>

  <main class="ref10-detail-main section-shell py-10">
    <% const isCustomizable = Boolean(product.hasCustomization); %>
    <% const isBraceletPlateImage = isCustomizable && product.mainImageUrl === '/images/muestras-carrito/brazaletes-4.jpeg'; %>
    <nav class="product-detail-breadcrumb" aria-label="Ruta de navegación">
      <a href="/">Inicio</a><span aria-hidden="true">/</span>
      <a href="/shop">Joyería</a>
      <% if (category) { %><span aria-hidden="true">/</span><a href="/shop?category=<%= category.slug %>"><%= category.name %></a><% } %>
      <% if (isCustomizable && (!category || category.slug !== 'personalizados')) { %><span aria-hidden="true">/</span><a href="/shop?category=personalizados">Personalizados</a><% } %>
      <span aria-hidden="true">/</span><span aria-current="page"><%= product.name %></span>
    </nav>

    <% if (cartAdded) { %>
      <div class="mb-6 rounded-xl bg-green-50 border border-green-200 text-green-700 px-4 py-3 text-sm">
        Producto agregado al carrito correctamente.
      </div>
    <% } %>

    <% if (stockLimited) { %>
      <div class="mb-6 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 text-sm">
        La cantidad fue limitada por el stock disponible.
      </div>
    <% } %>

    <% if (stockUnavailable) { %>
      <div class="mb-6 rounded-xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm">
        Este producto o variante está agotado y no puede agregarse al carrito.
      </div>
    <% } %>

    <% if (isCustomizable) { %>
      <ol class="product-customization-steps" aria-label="Etapas de compra">
        <li class="is-current"><span>1</span><strong>Personaliza</strong></li><i aria-hidden="true"></i>
        <li><span>2</span><strong>Revisa</strong></li><i aria-hidden="true"></i>
        <li><span>3</span><strong>Compra</strong></li>
      </ol>
    <% } %>

    <section class="product-detail-grid <%= isCustomizable ? 'is-customizable' : '' %>">
      <div class="product-detail-gallery-column">
        <div class="product-gallery-frame">
          <div class="product-gallery-stage <%= isBraceletPlateImage ? 'product-gallery-stage--bracelet-plate' : '' %>">
            <% if (defaultImage) { %>
              <img id="mainProductImage" src="<%= safePublicUrl(defaultImage) %>" alt="<%= product.name %>" class="product-gallery-image <%= isBraceletPlateImage ? 'product-gallery-image--bracelet-plate' : '' %>">
              <button type="button" class="product-gallery-expand" data-open-product-image aria-label="Ampliar imagen del producto">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m13-5h3a2 2 0 0 1 2 2v3M3 16v3a2 2 0 0 0 2 2h3m13-5v3a2 2 0 0 1-2 2h-3M9 9l-6-6m12 0 6-6M3 21l6-6m12 6-6-6"/></svg>
              </button>
            <% } else { %>
              <div id="mainProductImagePlaceholder" class="product-gallery-placeholder">Imagen del producto no disponible</div>
            <% } %>
          </div>
        </div>

        <% if ((product.gallery && product.gallery.some(function(item) { return item.type === 'image'; })) || defaultImage) { %>
          <div class="product-gallery-thumbnails" aria-label="Imágenes del producto">
            <% if (defaultImage) { %>
                <button type="button" class="thumb-btn is-active" data-image="<%= safePublicUrl(defaultImage) %>" aria-label="Ver imagen principal" aria-pressed="true">
                <img src="<%= safePublicUrl(defaultImage) %>" alt="<%= product.name %>">
              </button>
            <% } %>
            <% (product.gallery || []).forEach(function(item, index) { %>
              <% if (item.type === "image") { %>
                <button type="button" class="thumb-btn" data-image="<%= safePublicUrl(item.url) %>" aria-label="Ver imagen <%= index + 2 %> de <%= product.name %>" aria-pressed="false">
                  <img src="<%= safePublicUrl(item.url) %>" alt="<%= item.altText || product.name %>">
                </button>
              <% } %>
            <% }) %>
          </div>
        <% } %>

        <% if (isCustomizable) { %>
          <div class="product-reassurance-grid">
            <div><span aria-hidden="true">♧</span><p><strong>Envíos a toda RD</strong><small>Recibe tu pedido en cualquier provincia del país.</small></p></div>
            <div><span aria-hidden="true">◇</span><p><strong>Hecho para ti</strong><small>Personaliza esta pieza con las opciones disponibles.</small></p></div>
          </div>
        <% } %>

        <% if (product.videoUrl) { %>
          <div class="lux-card p-4 mt-6">
            <div class="moon-title mb-3">Video del producto</div>
            <video controls class="w-full rounded-[1.25rem] bg-black"><source src="<%= safePublicUrl(product.videoUrl) %>"></video>
          </div>
        <% } %>
      </div>

      <div class="product-detail-info-column">
        <div class="product-personalization-card <%= isCustomizable ? 'is-customizable' : '' %>">
          <% if (isCustomizable) { %>
            <div class="product-personalization-kicker"><span aria-hidden="true">✎</span> Personaliza tu joya</div>
          <% } else { %>
            <div class="product-personalization-kicker">Detalle del producto</div>
          <% } %>
          <% if (productUnavailable) { %><span class="badge-chip badge-danger">Agotado</span><% } %>
          <h1 class="product-detail-title"><%= product.name %></h1>
          <% if (product.shortDescription) { %><p class="product-detail-short-description"><%= product.shortDescription %></p><% } %>

          <div class="product-detail-price-row">
            <span id="productPrice" class="product-detail-price">RD$ <%= Number(defaultPrice || 0).toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
            <span id="productCompareAt" class="product-detail-compare <%= defaultCompareAt && defaultCompareAt > defaultPrice ? '' : 'hidden' %>">RD$ <%= Number(defaultCompareAt || 0).toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
          </div>
          <% if (engraving.fields.length) { %><p class="text-sm text-stone-600" id="productPriceBreakdown">Precio base <span id="productBasePriceText">RD$ <%= Number(defaultPrice || 0).toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span> · Personalización adicional <span id="productCustomizationSurcharge">RD$ 0.00</span></p><% } %>
          <div class="product-detail-stock <%= productUnavailable ? 'is-unavailable' : '' %>" id="stockState">
            <% if (productUnavailable) { %>Este producto está agotado.<% } else { %>Disponible: <%= defaultStock %><% } %>
          </div>

          <form action="/product/<%= product.slug %>/add-to-cart" method="post" enctype="multipart/form-data" id="addToCartForm" class="product-personalization-form">
            <input type="hidden" name="variantIndex" id="variantIndexInput" value="<%= (defaultVariantIndex !== null && defaultVariantIndex >= 0) ? defaultVariantIndex : '' %>">

            <%
              function splitMulti(text) {
                const parts = String(text || "").split(/\s*(?:\/|·|\|)\s*/).map((part) => part.trim()).filter(Boolean);
                return parts.length >= 2 ? parts : null;
              }
              function extractVariantAttributes(variant) {
                if (Array.isArray(variant?.attributes) && variant.attributes.length >= 2) {
                  const clean = variant.attributes
                    .map((a) => ({ name: String(a?.name || "").trim(), value: String(a?.value || "").trim() }))
                    .filter((a) => a.name && a.value);
                  if (clean.length >= 2) return clean;
                }
                const n1 = String(variant?.optionName || "").trim();
                const v1 = String(variant?.optionValue || "").trim();
                const n2 = String(variant?.optionName2 || "").trim();
                const v2 = String(variant?.optionValue2 || "").trim();
                if (v1 && v2) {
                  return [
                    { name: n1 || "Opción 1", value: v1 },
                    { name: n2 || "Opción 2", value: v2 }
                  ];
                }
                const pairVal = splitMulti(v1 || variant?.label);
                const pairName = splitMulti(n1);
                if (pairVal && pairName && pairVal.length === pairName.length) {
                  return pairName.map((name, idx) => ({ name, value: pairVal[idx] }));
                }
                return null;
              }
              const parsedVariants = (product.hasVariants && Array.isArray(product.variants))
                ? product.variants.map((variant, index) => ({ variant, index, attrs: extractVariantAttributes(variant) }))
                : [];
              const firstAttrCount = parsedVariants[0]?.attrs ? parsedVariants[0].attrs.length : 0;
              const hasLinkedVariants =
                parsedVariants.length > 0 &&
                firstAttrCount >= 2 &&
                parsedVariants.every((item) => item.attrs && item.attrs.length === firstAttrCount);
              const cascadeLevels = hasLinkedVariants
                ? parsedVariants[0].attrs.map((attr, levelIdx) => ({
                    name: attr.name,
                    values: Array.from(new Set(parsedVariants.map((item) => item.attrs[levelIdx].value)))
                  }))
                : [];
            %>

            <% if (hasLinkedVariants) { %>
              <% cascadeLevels.forEach(function(level, levelIdx) { %>
                <fieldset class="product-customization-group" data-linked-variant-group="<%= levelIdx === 0 ? 'primary' : (levelIdx === 1 ? 'secondary' : ('level-' + levelIdx)) %>" data-cascade-level="<%= levelIdx %>">
                  <legend><%= level.name %></legend>
                  <div class="product-variant-options" id="linkedOptionsLevel-<%= levelIdx %>">
                    <% level.values.forEach(function(val) { %>
                      <% const allUnavailable = levelIdx === 0 && parsedVariants.filter((item) => item.attrs[0].value === val).every((item) => isVariantUnavailable(item.variant)); %>
                      <button
                        type="button"
                        class="variant-btn linked-cascade-btn <%= levelIdx === 0 ? 'linked-primary-btn' : (levelIdx === 1 ? 'linked-secondary-btn' : '') %> <%= allUnavailable ? 'variant-unavailable' : '' %>"
                        data-level="<%= levelIdx %>"
                        data-value="<%= val %>"
                        <% if (levelIdx === 0) { %>data-primary-value="<%= val %>"<% } %>
                        <% if (levelIdx === 1) { %>data-secondary-value="<%= val %>"<% } %>
                        <%= allUnavailable ? 'disabled' : '' %>>
                        <%= val %><% if (allUnavailable) { %> · Agotado<% } %>
                      </button>
                    <% }) %>
                  </div>
                </fieldset>
              <% }) %>
            <% } else if (product.hasVariants && product.variants && product.variants.length) { %>
              <fieldset class="product-customization-group">
                <legend>Opciones disponibles</legend>
                <div class="product-variant-options" id="variantOptions">
                  <% product.variants.forEach(function(variant, index) { %>
                    <% const variantUnavailable = isVariantUnavailable(variant); %>
                    <button type="button" class="variant-btn <%= variantUnavailable ? 'variant-unavailable' : '' %>" data-index="<%= index %>" data-stock="<%= getVariantStock(variant) %>" data-unavailable="<%= variantUnavailable ? 'true' : 'false' %>" <%= variantUnavailable ? 'disabled' : '' %>>
                      <%= variant.label || variant.optionValue || ("Variante " + (index + 1)) %><% if (variantUnavailable) { %> · Agotado<% } %>
                    </button>
                  <% }) %>
                </div>
              </fieldset>
            <% } %>

            <% if (engraving.fields.length) { %>
              <fieldset class="product-customization-group">
                <legend>Personalización</legend>
                <% engraving.fields.forEach(function(field, index) { %>
                  <% const fieldId = 'custom-field-' + index; const previewId = fieldId + '-preview'; const limit = field.maxLength; %>
                  <div class="product-customization-field">
                    <label for="<%= fieldId %>"><%= field.label %><% if (field.required) { %><span class="required-mark"> *</span><% } else { %><span class="text-stone-500"> (opcional)</span><% } %><% if (field.priceDeltaMinor > 0) { %><span class="text-stone-600"> (+RD$ <%= (field.priceDeltaMinor / 100).toFixed(2) %>)</span><% } else { %><span class="text-stone-500"> (incluido)</span><% } %></label>
                    <div class="product-customization-input-wrap">
                      <input id="<%= fieldId %>" type="text" name="<%= field.inputName %>" class="customization-input" data-label="<%= field.label %>" data-required="<%= field.required ? 'true' : 'false' %>" data-price-delta-minor="<%= field.priceDeltaMinor || 0 %>" placeholder="<%= field.placeholder || '' %>" maxlength="<%= limit %>" <% if (field.required) { %>required<% } %> aria-describedby="<%= fieldId %>-count">
                      <span class="product-character-count" id="<%= fieldId %>-count" data-character-count="<%= fieldId %>">0/<%= limit %></span>
                    </div>
                    <div class="product-customization-live-preview" aria-label="Vista previa de <%= field.label %>">
                      <span class="product-customization-live-preview__caption">Vista previa · <%= field.label %></span>
                      <span class="product-font-sample product-font-sample--serif product-customization-live-preview__text" id="<%= previewId %>" aria-live="polite">Tu texto</span>
                    </div>
                  </div>
                <% }) %>
              </fieldset>
            <% } %>

            <% if (engraving.fields.length && engraving.fonts.length) { %>
              <% engraving.fields.forEach(function(field, fieldIndex) { %>
                <fieldset class="product-customization-group product-font-group" data-font-group-for="<%= field.inputName %>" <% if (fieldIndex > 0) { %>hidden<% } %>>
                  <legend>Tipografía · <%= field.label %></legend>
                  <div class="product-font-options" id="fontPicker-<%= fieldIndex %>">
                    <% engraving.fonts.forEach(function(font, fontIndex) { %>
                      <label class="product-font-option">
                        <input type="radio" name="<%= field.fontInputName %>" value="<%= font.name %>" class="font-option" data-font-for="<%= fieldIndex %>" data-preview-style="<%= font.sampleStyle %>" <%= fontIndex === 0 ? 'checked' : '' %>>
                        <% if (font.previewImageUrl) { %><img src="<%= safePublicUrl(font.previewImageUrl) %>" alt=""><% } else { %><span class="product-font-sample product-font-sample--<%= font.sampleStyle %>" aria-hidden="true"><%= font.previewText || 'Aa' %></span><% } %>
                        <span><%= font.name %></span>
                      </label>
                    <% }) %>
                  </div>
                </fieldset>
              <% }) %>
            <% } %>

            <% if (engraving.photo) { %>
              <div class="product-customization-field product-photo-upload">
                <label for="customizationPhoto">Añadir fotografía <span>(opcional)</span></label>
                <input id="customizationPhoto" type="file" name="customizationPhoto" accept="image/jpeg,image/png,image/webp">
                <small>JPG, PNG o WEBP · Máximo 15 MB</small>
                <small>La imagen se adjuntará al pedido para revisión.</small>
              </div>
            <% } %>

            <div class="product-purchase-row">
              <div class="product-quantity-block">
                <label for="quantityInput">Cantidad</label>
                <div class="product-quantity-stepper">
                  <button type="button" data-quantity-step="-1" aria-label="Reducir cantidad" <%= productUnavailable ? 'disabled' : '' %>>−</button>
                  <input type="number" name="quantity" id="quantityInput" min="1" max="<%= defaultStock || 1 %>" value="1" <%= productUnavailable ? 'disabled' : '' %> aria-label="Cantidad">
                  <button type="button" data-quantity-step="1" aria-label="Aumentar cantidad" <%= productUnavailable ? 'disabled' : '' %>>+</button>
                </div>
              </div>
              <p class="product-line-total"><span>Total:</span> <strong id="productLineTotal">RD$ <%= Number(defaultPrice || 0).toLocaleString('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong></p>
            </div>

            <% if (engraving.unavailable) { %><p role="status">La configuración del grabado no está disponible. Consulta por WhatsApp.</p><% } %>
            <% if (engravingInvalid) { %><p role="alert">Revisa el texto, el límite de caracteres y la tipografía antes de continuar.</p><% } %>
            <% if (engravingUploadInvalid) { %><p role="alert">Selecciona una sola imagen JPG, PNG o WEBP de hasta 15 MB.</p><% } %>
            <button type="submit" id="addToCartButton" class="product-add-to-cart" <%= (productUnavailable || engraving.unavailable) ? 'disabled' : '' %>>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h2l2.4 12.1a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 2-1.6L22 8H7M10 21a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm8 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"/></svg>
              <span><%= productUnavailable ? 'Agotado' : engraving.unavailable ? 'Grabado no disponible' : 'Agregar al carrito' %></span>
            </button>
            <a id="whatsappButton" href="<%= initialWhatsAppUrl %>" target="_blank" rel="noopener" class="product-whatsapp-link">Consultar por WhatsApp</a>
            <% if (isCustomizable) { %><p class="product-customization-note">La personalización seleccionada se adjuntará al pedido.</p><% } %>
          </form>

          <% if (product.description) { %>
            <div class="product-detail-description"><h2>Detalles del producto</h2><p><%= product.description %></p></div>
          <% } %>
        </div>
      </div>
    </section>

    <% if (defaultImage) { %>
      <dialog class="product-image-dialog <%= isBraceletPlateImage ? 'product-image-dialog--bracelet-plate' : '' %>" id="productImageDialog" aria-label="Imagen ampliada de <%= product.name %>">
        <button type="button" data-close-product-image aria-label="Cerrar imagen ampliada">×</button>
        <div class="product-image-dialog-stage <%= isBraceletPlateImage ? 'product-image-dialog-stage--bracelet-plate' : '' %>">
          <img src="<%= safePublicUrl(defaultImage) %>" id="expandedProductImage" alt="<%= product.name %>" <%= isBraceletPlateImage ? 'class="product-image-dialog-image--bracelet-plate"' : '' %>>
        </div>
      </dialog>
    <% } %>

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-14">
      <div class="lux-card p-6">
        <div class="moon-title">Reseñas</div>
        <h2 class="brand-serif text-3xl mt-3 mb-6 text-stone-900">Opiniones del producto</h2>

        <% if (reviews && reviews.length) { %>
          <div class="space-y-4">
            <% reviews.forEach(function(review) { %>
              <div class="review-card-public">
                <% if (review.photoUrl) { %>
                  <img src="<%= safePublicUrl(review.photoUrl) %>" alt="Foto de reseña de <%= review.customerName %>" class="review-card-public__photo">
                <% } %>

                <div class="review-card-public__body">
                  <div class="text-amber-500 text-lg mb-2"><%= "★".repeat(review.rating || 5) %></div>
                  <p class="text-stone-700 leading-7"><%= review.comment %></p>
                  <p class="mt-3 text-sm text-stone-500 font-medium"><%= review.customerName %></p>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-stone-500">Aún no hay reseñas aprobadas para este producto.</div>
        <% } %>
      </div>

      <div class="lux-card p-6">
        <div class="moon-title">Deja tu opinión</div>
        <h2 class="brand-serif text-3xl mt-3 mb-6 text-stone-900">Enviar reseña</h2>

        <% if (reviewSubmitted) { %>
          <div class="mb-6 rounded-xl bg-green-50 border border-green-200 text-green-700 px-4 py-3 text-sm">
            Tu reseña fue enviada. Quedará visible al ser aprobada.
          </div>
        <% } %>

        <% if (reviewInvalid) { %>
          <div class="mb-6 rounded-xl bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 text-sm">
            Para enviar tu reseña necesitamos nombre, correo válido, puntuación y comentario.
          </div>
        <% } %>

        <% if (reviewError) { %>
          <div class="mb-6 rounded-xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm">
            No pudimos recibir la reseña. Intenta nuevamente con una imagen JPG, PNG o WEBP menor de 10 MB.
          </div>
        <% } %>

        <form action="/product/<%= product.slug %>/reviews" method="post" enctype="multipart/form-data" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Tu nombre</label>
            <input type="text" name="customerName" required class="w-full rounded-xl border border-stone-300 px-4 py-3">
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Correo</label>
            <input type="email" name="email" required placeholder="tu@email.com" class="w-full rounded-xl border border-stone-300 px-4 py-3">
            <p class="mt-2 text-xs text-stone-500">Usaremos el correo solo como validación básica de reseña. No se mostrará públicamente.</p>
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Puntuación</label>
            <select name="rating" class="w-full rounded-xl border border-stone-300 px-4 py-3">
              <option value="5">5 estrellas</option>
              <option value="4">4 estrellas</option>
              <option value="3">3 estrellas</option>
              <option value="2">2 estrellas</option>
              <option value="1">1 estrella</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Comentario</label>
            <textarea name="comment" rows="5" required class="w-full rounded-xl border border-stone-300 px-4 py-3"></textarea>
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Foto opcional</label>
            <input type="file" name="reviewPhoto" accept="image/jpeg,image/png,image/webp" class="w-full rounded-xl border border-stone-300 px-4 py-3 bg-white">
            <p class="mt-2 text-xs text-stone-500">Puedes subir una foto JPG, PNG o WEBP. Máximo 10 MB.</p>
          </div>

          <button type="submit" class="lux-btn lux-btn-primary">
            Enviar reseña
          </button>
        </form>
      </div>
    </section>

    <% if (relatedProducts && relatedProducts.length) { %>
      <section class="mt-14">
        <div class="moon-title">Relacionados</div>
        <h2 class="brand-serif text-4xl mt-3 mb-8 text-stone-900">También te puede interesar</h2>

        <div class="collection-grid">
          <% relatedProducts.forEach(function(item) { %>
            <a href="/product/<%= item.slug %>" class="product-card block">
              <div class="product-image-wrap">
                <% if (item.mainImageUrl) { %>
                  <img src="<%= safePublicUrl(item.mainImageUrl) %>" alt="<%= item.name %>">
                <% } else { %>
                  <div class="w-full h-full flex items-center justify-center text-stone-400">Sin imagen</div>
                <% } %>
              </div>

              <div class="p-5">
                <h3 class="font-semibold text-stone-900"><%= item.name %></h3>
                <div class="mt-2 text-stone-900 font-medium">
                  RD$ <%= Number(item.basePrice || 0).toFixed(2) %>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>
  </main>

  <%- include("../partials/footer") %>

  <script>
    (function () {
      const variants = <%- jsonForInlineScript(product.variants || []) %>;
      const defaultVariantIndex = <%- jsonForInlineScript((defaultVariantIndex !== null && defaultVariantIndex >= 0) ? defaultVariantIndex : null) %>;
      const productUnavailable = <%- jsonForInlineScript(Boolean(productUnavailable)) %>;
      const engravingUnavailable = <%- jsonForInlineScript(engraving.unavailable) %>;
      const productStock = <%- jsonForInlineScript(Number(defaultStock || 0)) %>;
      const basePrice = <%- jsonForInlineScript(Number(product.basePrice || 0)) %>;
      const baseCompareAt = <%- jsonForInlineScript(Number(product.compareAtPrice || 0)) %>;
      const priceEl = document.getElementById("productPrice");
      const compareEl = document.getElementById("productCompareAt");
      const mainImage = document.getElementById("mainProductImage");
      const expandedImage = document.getElementById("expandedProductImage");
      const imageDialog = document.getElementById("productImageDialog");
      const stockState = document.getElementById("stockState");
      const whatsappButton = document.getElementById("whatsappButton");
      const variantButtons = document.querySelectorAll("#variantOptions .variant-btn");

      function safeProductImageUrl(value) {
        const candidate = String(value || "").trim();
        if (/^\/(?!\/)/.test(candidate) && !/[\u0000-\u0020\\]/.test(candidate)) return candidate;
        try {
          const parsed = new URL(candidate);
          return ["http:", "https:"].includes(parsed.protocol) && !parsed.username && !parsed.password
            ? parsed.href
            : "";
        } catch (_) {
          return "";
        }
      }
      const customizationInputs = document.querySelectorAll(".customization-input");
      const fontOptions = document.querySelectorAll(".font-option");
      const variantIndexInput = document.getElementById("variantIndexInput");
      const quantityInput = document.getElementById("quantityInput");
      const addToCartButton = document.getElementById("addToCartButton");
      const addToCartLabel = addToCartButton && addToCartButton.querySelector("span");
      const lineTotalEl = document.getElementById("productLineTotal");
      const basePriceTextEl = document.getElementById("productBasePriceText");
      const surchargeTextEl = document.getElementById("productCustomizationSurcharge");

      let selectedVariantIndex = variants.length ? (defaultVariantIndex !== null ? defaultVariantIndex : 0) : null;
      let selectedVariant = selectedVariantIndex !== null ? variants[selectedVariantIndex] : null;

      function formatPrice(value) {
        return "RD$ " + Number(value || 0).toLocaleString("es-DO", {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        });
      }

      function variantStock(variant) {
        return Math.max(0, Number((variant && variant.stock) || 0));
      }

      function variantUnavailable(variant) {
        return Boolean(variant && variant.outOfStock) || variantStock(variant) <= 0;
      }

      function getSelectedFont() {
        const checked = document.querySelector(".font-option:checked");
        return checked ? checked.value : "";
      }

      function fitImagePreviewText(preview) {
        if (!preview || !preview.classList.contains("product-customization-image-preview__text")) return;
        preview.style.fontSize = "";
        let fontSize = parseFloat(window.getComputedStyle(preview).fontSize) || 14;
        while (preview.scrollWidth > preview.clientWidth && fontSize > 8) {
          fontSize = Math.max(8, fontSize - 1);
          preview.style.fontSize = fontSize + "px";
        }
      }

      function updateEngravingPreviews() {
        customizationInputs.forEach(function (input, index) {
          const selectedFont = document.querySelector('.font-option[data-font-for="' + index + '"]:checked');
          const previewStyle = selectedFont?.dataset.previewStyle || "serif";
          const safeStyle = /^[a-z0-9-]{1,40}$/i.test(previewStyle) ? previewStyle : "serif";
          const preview = document.getElementById(input.id + "-preview");
          if (!preview) return;

          preview.textContent = (input.value || "").trim() || "Tu texto";
          Array.from(preview.classList)
            .filter(function (className) { return className.startsWith("product-font-sample--"); })
            .forEach(function (className) { preview.classList.remove(className); });
          preview.classList.add("product-font-sample--" + safeStyle);
          fitImagePreviewText(preview);
        });
      }

      function getCustomizationText() {
        const parts = [];

        customizationInputs.forEach(function (input, index) {
          const value = (input.value || "").trim();
          const label = input.dataset.label || "Dato";
          if (value) {
            parts.push(label + ": " + value);
            const selectedFont = document.querySelector('.font-option[data-font-for="' + index + '"]:checked');
            if (selectedFont) parts.push("Tipografía " + label + ": " + selectedFont.value);
          }
        });

        return parts.join(" | ");
      }

      function updateFontGroupVisibility() {
        customizationInputs.forEach(function (input, index) {
          const group = document.querySelector('[data-font-group-for="' + input.name + '"]');
          if (!group) return;
          group.hidden = index > 0 && !(input.value || "").trim();
        });
      }

      function updateLineTotal() {
        if (!lineTotalEl) return;
        const baseUnitPrice = Number(selectedVariant?.price ?? basePrice ?? 0);
        const surchargeMinor = Array.from(customizationInputs).reduce(function (sum, input) {
          return sum + ((input.value || "").trim() ? Math.max(0, Number(input.dataset.priceDeltaMinor || 0)) : 0);
        }, 0);
        const surcharge = surchargeMinor / 100;
        const unitPrice = baseUnitPrice + surcharge;
        const quantity = Math.max(1, Number(quantityInput?.value || 1));
        if (priceEl) priceEl.textContent = formatPrice(unitPrice);
        if (basePriceTextEl) basePriceTextEl.textContent = formatPrice(baseUnitPrice);
        if (surchargeTextEl) surchargeTextEl.textContent = formatPrice(surcharge);
        lineTotalEl.textContent = formatPrice(unitPrice * quantity);
      }

      function updateCharacterCount(input) {
        const counter = input.id ? document.getElementById(input.id + "-count") : null;
        if (!counter) return;
        counter.textContent = `${(input.value || "").length}/${input.maxLength || 100}`;
      }

      function updateHiddenInputs() {
        if (variantIndexInput) {
          variantIndexInput.value = selectedVariantIndex !== null ? selectedVariantIndex : "";
        }
      }

      function updateWhatsAppLink() {
        const basePhone = "18493306269";
        const productName = <%- jsonForInlineScript(product.name || "") %>;
        const variantLabel = selectedVariant ? (selectedVariant.label || selectedVariant.optionValue || "") : "";
        const customization = getCustomizationText();

        let message = "Hola, me interesa el producto: " + productName;
        if (variantLabel) message += " | Variante: " + variantLabel;
        if (customization) message += " | " + customization;

        if (whatsappButton) whatsappButton.href = "https://wa.me/" + basePhone + "?text=" + encodeURIComponent(message);
        updateHiddenInputs();
      }

      function updateBuyState(isUnavailable, stock) {
        const safeStock = Math.max(0, Number(stock || 0));

        if (quantityInput) {
          quantityInput.max = safeStock > 0 ? String(safeStock) : "1";
          quantityInput.disabled = isUnavailable;
          if (!isUnavailable) {
            const currentQty = Math.max(1, Number(quantityInput.value || 1));
            quantityInput.value = Math.min(currentQty, safeStock).toString();
          }
        }

        if (addToCartButton) {
          addToCartButton.disabled = isUnavailable || engravingUnavailable;
          if (addToCartLabel) addToCartLabel.textContent = isUnavailable ? "Agotado" : engravingUnavailable ? "Grabado no disponible" : "Agregar al carrito";
        }

        if (stockState) {
          stockState.textContent = isUnavailable ? "Agotado" : "Disponible: " + safeStock;
          stockState.classList.toggle("is-unavailable", isUnavailable);
        }
        updateLineTotal();
      }

      function applyVariant(variant, clickedButton, index) {
        selectedVariant = variant;
        selectedVariantIndex = index;

        const price = Number(variant.price || 0);
        const compareAt = Number(variant.compareAtPrice || 0);
        const unavailable = variantUnavailable(variant);
        const stock = variantStock(variant);

        if (priceEl) {
          priceEl.textContent = formatPrice(price);
        }

        if (compareEl) {
          if (compareAt > price) {
            compareEl.textContent = formatPrice(compareAt);
            compareEl.classList.remove("hidden");
          } else {
            compareEl.classList.add("hidden");
          }
        }

        const variantImageUrl = safeProductImageUrl(variant.imageUrl);
        if (variantImageUrl && mainImage) {
          mainImage.src = variantImageUrl;
          if (expandedImage) expandedImage.src = variantImageUrl;
        }

        updateBuyState(unavailable, stock);

        variantButtons.forEach(function (btn) {
          btn.classList.remove("active-variant");
        });

        if (clickedButton) {
          clickedButton.classList.add("active-variant");
        }

        updateWhatsAppLink();
      }

      document.querySelectorAll(".thumb-btn").forEach(function (button) {
        button.addEventListener("click", function () {
          const image = this.dataset.image;
          if (image && mainImage) {
            mainImage.src = image;
            if (expandedImage) expandedImage.src = image;
          }

          document.querySelectorAll(".thumb-btn").forEach(function (btn) {
            btn.classList.remove("active-thumb", "is-active");
            btn.setAttribute("aria-pressed", "false");
          });
          this.classList.add("active-thumb", "is-active");
          this.setAttribute("aria-pressed", "true");
        });
      });

      const openImageButton = document.querySelector("[data-open-product-image]");
      const closeImageButton = document.querySelector("[data-close-product-image]");
      if (openImageButton && imageDialog) openImageButton.addEventListener("click", function () {
        imageDialog.showModal();
      });
      if (closeImageButton && imageDialog) closeImageButton.addEventListener("click", function () { imageDialog.close(); });
      if (imageDialog) {
        imageDialog.addEventListener("click", function (event) {
          if (event.target === imageDialog) imageDialog.close();
        });
      }

      variantButtons.forEach(function (button) {
        button.addEventListener("click", function () {
          const index = Number(this.dataset.index);
          if (!Number.isNaN(index) && variants[index]) {
            applyVariant(variants[index], this, index);
          }
        });
      });

      customizationInputs.forEach(function (input) {
        updateCharacterCount(input);
        input.addEventListener("input", function () {
          updateCharacterCount(input);
          updateFontGroupVisibility();
          updateEngravingPreviews();
          updateWhatsAppLink();
          updateLineTotal();
        });
      });


      fontOptions.forEach(function (radio) {
        radio.addEventListener("change", function () {
          updateEngravingPreviews();
          updateWhatsAppLink();
        });
      });

      window.addEventListener("resize", updateEngravingPreviews);
      updateFontGroupVisibility();
      updateEngravingPreviews();

      if (quantityInput) {
        quantityInput.addEventListener("input", function () {
          const max = Math.max(1, Number(quantityInput.max || 1));
          const value = Math.max(1, Number(quantityInput.value || 1));
          if (value > max) quantityInput.value = max.toString();
          if (Number(quantityInput.value) < 1) quantityInput.value = "1";
          updateLineTotal();
        });
      }

      document.querySelectorAll("[data-quantity-step]").forEach(function (button) {
        button.addEventListener("click", function () {
          if (!quantityInput || quantityInput.disabled) return;
          const min = Math.max(1, Number(quantityInput.min || 1));
          const max = Math.max(min, Number(quantityInput.max || 1));
          const next = Number(quantityInput.value || 1) + Number(button.dataset.quantityStep || 0);
          quantityInput.value = String(Math.min(max, Math.max(min, next)));
          updateLineTotal();
        });
      });

      const cascadeGroups = Array.from(document.querySelectorAll("[data-cascade-level]"));

      function parseClientMulti(text) {
        const parts = String(text || "").split(/\s*(?:\/|·|\|)\s*/).map(function (p) { return p.trim(); }).filter(Boolean);
        return parts.length >= 2 ? parts : null;
      }

      function getVariantAttrValues(variant) {
        if (Array.isArray(variant?.attributes) && variant.attributes.length >= 2) {
          const vals = variant.attributes.map(function (a) { return String(a?.value || "").trim(); }).filter(Boolean);
          if (vals.length >= 2) return vals;
        }
        const v1 = String(variant?.optionValue || "").trim();
        const v2 = String(variant?.optionValue2 || "").trim();
        if (v1 && v2) return [v1, v2];
        const pv = parseClientMulti(v1 || variant?.label);
        const pn = parseClientMulti(variant?.optionName);
        if (pv && pn && pv.length === pn.length) return pv;
        return null;
      }

      const activeCascadeValues = [];

      function syncCascade(fromLevel, chosenValue) {
        const indexed = variants
          .map(function (v, idx) { return { v: v, idx: idx, vals: getVariantAttrValues(v) }; })
          .filter(function (item) { return Array.isArray(item.vals) && item.vals.length === cascadeGroups.length; });

        if (!indexed.length) return;
        if (typeof fromLevel === "number" && chosenValue !== undefined) {
          activeCascadeValues[fromLevel] = chosenValue;
        }

        let pool = indexed;
        cascadeGroups.forEach(function (group, levelIdx) {
          const buttons = group.querySelectorAll(".linked-cascade-btn");
          const availSet = new Set(
            pool
              .filter(function (item) { return !variantUnavailable(item.v); })
              .map(function (item) { return item.vals[levelIdx]; })
          );

          let selectedVal = activeCascadeValues[levelIdx];
          if (!selectedVal || !availSet.has(selectedVal)) {
            const firstAvail = pool.find(function (item) { return !variantUnavailable(item.v); });
            selectedVal = firstAvail ? firstAvail.vals[levelIdx] : (pool[0]?.vals[levelIdx] || "");
          }
          activeCascadeValues[levelIdx] = selectedVal;

          buttons.forEach(function (btn) {
            const val = btn.dataset.value;
            const isDisabled = !availSet.has(val);
            btn.disabled = isDisabled;
            btn.classList.toggle("variant-unavailable", isDisabled);
            btn.classList.toggle("active-variant", !isDisabled && val === selectedVal);
            btn.title = isDisabled ? "No disponible en esta combinación" : "";
          });

          pool = pool.filter(function (item) { return item.vals[levelIdx] === selectedVal; });
        });

        const matched = pool[0];
        if (matched) {
          applyVariant(matched.v, null, matched.idx);
        }
      }

      if (cascadeGroups.length >= 2 && variants.length) {
        cascadeGroups.forEach(function (group, levelIdx) {
          group.querySelectorAll(".linked-cascade-btn").forEach(function (btn) {
            btn.addEventListener("click", function () {
              if (this.disabled) return;
              syncCascade(levelIdx, this.dataset.value);
            });
          });
        });

        const initialIdx = selectedVariantIndex !== null ? selectedVariantIndex : 0;
        const initialVals = getVariantAttrValues(variants[initialIdx]) || getVariantAttrValues(variants[0]);
        if (initialVals) {
          initialVals.forEach(function (val, i) { activeCascadeValues[i] = val; });
          syncCascade(0, initialVals[0]);
        }
      } else if (variantButtons.length && variants.length) {
        const initialButton = selectedVariantIndex !== null ? variantButtons[selectedVariantIndex] : variantButtons[0];
        applyVariant(selectedVariant || variants[0], initialButton, selectedVariantIndex !== null ? selectedVariantIndex : 0);
      } else {
        if (priceEl) priceEl.textContent = formatPrice(basePrice);
        if (compareEl && baseCompareAt > basePrice) compareEl.textContent = formatPrice(baseCompareAt);
        updateBuyState(productUnavailable, productStock);
        updateWhatsAppLink();
      }

      updateLineTotal();
    })();
  </script>
</body>
</html>
