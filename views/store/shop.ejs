<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catálogo | <%= siteSettings?.brandName || "GATON DO" %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/app.css?v=ref10c-mobilefit">
  <style>
    .ref10-shop-filter-card {
      grid-template-columns: minmax(220px, 1.4fr) minmax(170px, 1fr) minmax(170px, 1fr) auto !important;
    }
    @media (max-width: 980px) {
      .ref10-shop-filter-card {
        grid-template-columns: 1fr 1fr !important;
      }
      .ref10-filter-search, .ref10-filter-actions {
        grid-column: 1 / -1;
      }
    }
    @media (max-width: 600px) {
      .ref10-shop-filter-card {
        grid-template-columns: 1fr !important;
      }
    }
    .ref10-shop-gender-chips {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      margin: -0.75rem auto 1.75rem;
      max-width: 1120px;
      padding: 0 1.25rem;
    }
    .ref10-shop-gender-chips a {
      display: inline-flex;
      align-items: center;
      padding: 0.42rem 0.95rem;
      border-radius: 999px;
      border: 1px solid #d9d2c5;
      background: #fff;
      color: #3f3a34;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.15s ease;
    }
    .ref10-shop-gender-chips a:hover {
      border-color: #0b2c32;
      color: #0b2c32;
    }
    .ref10-shop-gender-chips a.active {
      background: #0b2c32;
      border-color: #0b2c32;
      color: #fff;
    }
  </style>
</head>
<body class="ref10-body ref10-shop-page">
  <%
    function t(value, fallback = "") {
      const cleaner = typeof displayText === "function" ? displayText : (text) => String(text || "");
      return cleaner(value || fallback || "");
    }
    function categoryLabel(product) {
      const ids = Array.isArray(product.categoryIds) && product.categoryIds.length
        ? product.categoryIds.map(String)
        : (product.categoryId ? [String(product.categoryId)] : []);
      const names = ids.map((id) => (categoryMap && categoryMap[id] ? categoryMap[id].name : "")).filter(Boolean);
      return names.length ? names.join(" · ") : "Joyería";
    }
    function shopUrl(params = {}) {
      const qs = new URLSearchParams();
      if (params.q) qs.set("q", params.q);
      if (params.category) qs.set("category", params.category);
      if (params.gender) qs.set("gender", params.gender);
      const str = qs.toString();
      return str ? ("/shop?" + str) : "/shop";
    }
  %>

  <%- include("../partials/header") %>

  <main class="ref10-shop-main">
    <section class="ref10-shop-hero">
      <span>Catálogo</span>
      <h1><%= selectedCategory ? t(selectedCategory.name) : t(siteSettings?.catalogTitle, "Joyería") %></h1>
      <p><%= t(siteSettings?.catalogText, "Cada pieza está pensada para acompañarte. Selecciona, agrega al carrito y finaliza tu pedido por WhatsApp.") %></p>
    </section>

    <section class="ref10-shop-filter-wrap">
      <form method="get" action="/shop" class="ref10-shop-filter-card">
        <div class="ref10-filter-field ref10-filter-search">
          <label>Buscar</label>
          <input type="text" name="q" value="<%= currentQuery || '' %>" placeholder="<%= siteSettings?.searchHint || 'Busca por nombre o etiqueta' %>">
        </div>

        <div class="ref10-filter-field">
          <label>Categoría</label>
          <select name="category">
            <option value="">Todas</option>
            <% (categories || []).forEach(category => { %>
              <option value="<%= category.slug %>" <%= currentCategorySlug === category.slug ? "selected" : "" %>><%= t(category.name) %></option>
            <% }) %>
          </select>
        </div>

        <div class="ref10-filter-field">
          <label>Género</label>
          <select name="gender">
            <option value="">Todos</option>
            <% (genderOptions || []).filter(o => o.value).forEach(option => { %>
              <option value="<%= option.value %>" <%= currentGender === option.value ? "selected" : "" %>><%= option.label %></option>
            <% }) %>
          </select>
        </div>

        <div class="ref10-filter-actions">
          <button type="submit"><%= siteSettings?.filterLabel || "Filtrar" %></button>
          <a href="/shop"><%= siteSettings?.clearLabel || "Limpiar" %></a>
        </div>
      </form>
    </section>

    <section class="ref10-shop-chips">
      <a href="<%= shopUrl({ q: currentQuery, gender: currentGender }) %>" class="<%= !currentCategorySlug ? 'active' : '' %>">Todo</a>
      <% (categories || []).forEach(category => { %>
        <a href="<%= shopUrl({ q: currentQuery, category: category.slug, gender: currentGender }) %>" class="<%= currentCategorySlug === category.slug ? 'active' : '' %>"><%= t(category.name) %></a>
      <% }) %>
    </section>

    <section class="ref10-shop-gender-chips" aria-label="Filtrar por género o público">
      <a href="<%= shopUrl({ q: currentQuery, category: currentCategorySlug }) %>" class="<%= !currentGender ? 'active' : '' %>">Todos los géneros</a>
      <% (genderOptions || []).filter(o => o.value).forEach(option => { %>
        <a href="<%= shopUrl({ q: currentQuery, category: currentCategorySlug, gender: option.value }) %>" class="<%= currentGender === option.value ? 'active' : '' %>"><%= option.label %></a>
      <% }) %>
    </section>

    <section class="ref10-shop-products">
      <% if (!products.length) { %>
        <div class="ref10-empty-state">No hay productos para mostrar con esos filtros.</div>
      <% } else { %>
        <div class="ref10-product-grid ref10-shop-product-grid">
          <% products.forEach((product, index) => { %>
            <a href="/product/<%= product.slug %>" class="ref10-product-card">
              <div class="ref10-product-image">
                <% if (product.featured || index === 0) { %><span class="ref10-product-badge"><%= product.featured ? 'Destacado' : 'Nuevo' %></span><% } %>
                <% if (isProductUnavailable && isProductUnavailable(product)) { %><span class="ref10-product-badge danger">Agotado</span><% } %>
                <% if (product.mainImageUrl) { %>
                  <img src="<%= safePublicUrl(product.mainImageUrl) %>" alt="<%= t(product.name) %>">
                <% } else { %>
                  <img src="/images/logo-gatondo-color.png" alt="GATON DO" class="ref10-product-placeholder">
                <% } %>
              </div>
              <div class="ref10-product-copy">
                <small><%= t(categoryLabel(product)) %></small>
                <h3><%= t(product.name) %></h3>
                <% if (product.shortDescription) { %><p><%= t(product.shortDescription) %></p><% } %>
                <div class="ref10-product-bottom">
                  <strong><%= formatCurrency ? formatCurrency(product.basePrice || 0) : ('RD$ ' + Number(product.basePrice || 0).toLocaleString('en-US')) %></strong>
                  <span>+</span>
                </div>
                <% if (product.compareAtPrice && product.compareAtPrice > product.basePrice) { %>
                  <div class="ref10-old-price"><%= formatCurrency(product.compareAtPrice || 0) %></div>
                <% } %>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include("../partials/footer") %>
</body>
</html>
