<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout | <%= siteSettings?.brandName || "GATON DO" %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/app.css?v=ref10c-mobilefit">
</head>
<body class="ref10-body ref10-checkout-page bg-[#f8f6f2] text-stone-900">
  <%- include("../partials/header") %>

  <main class="ref10-checkout-main max-w-7xl mx-auto px-4 py-10">
    <section class="mb-8">
      <p class="text-xs uppercase tracking-[0.35em] text-stone-500">Checkout</p>
      <h1 class="text-4xl font-semibold mt-2">Completa tu pedido</h1>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr,0.8fr] gap-8">
      <section class="bg-white border border-stone-200 rounded-3xl p-6 shadow-sm">
        <form action="/checkout" method="post" id="checkoutForm" class="space-y-6">
          <input type="hidden" name="checkoutToken" value="<%= checkoutToken %>">
          <div>
            <h2 class="text-2xl font-semibold mb-5">Datos del cliente</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-2">Nombre completo *</label>
              <input type="text" name="customerName" required class="w-full rounded-xl border border-stone-300 px-4 py-3">
            </div>

            <div>
              <label class="block text-sm font-medium text-stone-700 mb-2">Teléfono *</label>
              <input type="text" name="phone" required class="w-full rounded-xl border border-stone-300 px-4 py-3">
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Correo</label>
            <input type="email" name="email" class="w-full rounded-xl border border-stone-300 px-4 py-3">
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Método de envío *</label>
            <select name="shippingMethod" id="shippingMethod" required class="w-full rounded-xl border border-stone-300 px-4 py-3">
              <option value="">Selecciona una opción</option>
              <% shippingOptions.forEach(option => { %>
                <option
                  value="<%= option.name %>"
                  data-price="<%= Number(option.price || 0) %>"
                  data-description="<%= option.description || '' %>">
                  <%= option.name %> - RD$ <%= Number(option.price || 0).toFixed(2) %>
                </option>
              <% }) %>
            </select>
            <p id="shippingDescription" class="text-sm text-stone-500 mt-2"></p>
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Notas del pedido</label>
            <textarea name="notes" rows="4" class="w-full rounded-xl border border-stone-300 px-4 py-3" placeholder="Detalles adicionales, referencia de dirección, etc."></textarea>
          </div>

          <button type="submit" class="rounded-xl bg-stone-900 text-white px-6 py-3 font-medium hover:bg-stone-800">
            Confirmar pedido
          </button>
        </form>
      </section>

      <aside>
        <div class="bg-white border border-stone-200 rounded-3xl p-6 shadow-sm sticky top-24">
          <h2 class="text-2xl font-semibold mb-6">Resumen del pedido</h2>

          <div class="space-y-4 max-h-[320px] overflow-auto pr-2">
            <% cart.forEach(item => { %>
              <div class="border-b border-stone-100 pb-4">
                <div class="font-medium text-stone-900"><%= item.productName %></div>
                <div class="text-sm text-stone-500 mt-1">Cantidad: <%= item.quantity %></div>
                <% if (item.variantLabel || item.variantOptionValue) { %>
                  <div class="text-sm text-stone-500 mt-1">
                    Variante: <%= item.variantLabel || item.variantOptionValue %>
                  </div>
                <% } %>
                <% if (item.customizationSummary) { %>
                  <div class="text-sm text-stone-500 mt-1">Personalización: <%= item.customizationSummary %></div>
                <% } %>
                <% if (item.customizationPhotoUrl) { %>
                  <div class="text-sm text-stone-500 mt-1">Foto cargada para fotograbado: <a href="<%= item.customizationPhotoUrl %>" target="_blank" class="text-[#016B83] underline">ver imagen</a></div>
                <% } %>
                <div class="text-sm text-stone-500 mt-1">
                  RD$ <%= Number(item.lineTotal || 0).toFixed(2) %>
                </div>
              </div>
            <% }) %>
          </div>

          <div class="mt-6 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-stone-600">Subtotal</span>
              <span id="subtotalText" class="font-medium">RD$ <%= Number(subtotal || 0).toFixed(2) %></span>
            </div>

            <div class="flex items-center justify-between">
              <span class="text-stone-600">Envío</span>
              <span id="shippingText" class="font-medium">RD$ 0.00</span>
            </div>

            <div class="border-t border-stone-200 pt-3 flex items-center justify-between">
              <span class="text-lg font-semibold text-stone-900">Total</span>
              <span id="totalText" class="text-lg font-semibold text-stone-900">RD$ <%= Number(subtotal || 0).toFixed(2) %></span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <script>
    (function () {
      const shippingSelect = document.getElementById("shippingMethod");
      const shippingDescription = document.getElementById("shippingDescription");
      const shippingText = document.getElementById("shippingText");
      const totalText = document.getElementById("totalText");
      const subtotal = Number(<%- JSON.stringify(Number(subtotal || 0)) %>);

      function updateSummary() {
        const option = shippingSelect.options[shippingSelect.selectedIndex];
        const shippingPrice = option ? Number(option.dataset.price || 0) : 0;
        const description = option ? (option.dataset.description || "") : "";

        shippingText.textContent = "RD$ " + shippingPrice.toFixed(2);
        totalText.textContent = "RD$ " + (subtotal + shippingPrice).toFixed(2);
        shippingDescription.textContent = description;
      }

      shippingSelect.addEventListener("change", updateSummary);
      updateSummary();
    })();
  </script>
</body>
</html>
