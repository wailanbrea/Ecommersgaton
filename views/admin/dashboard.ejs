<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= adminPageTitle || 'Dashboard' %> | GATÓN DO</title>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/admin-utilities.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-shell-body">
  <%- include("../partials/admin-shell-start") %>
  <main class="admin-dashboard-main">
    <section class="admin-dashboard-heading">
      <h2>Dashboard</h2>
      <p>Desde aquí administras productos, pedidos, reseñas y configuración del sitio.</p>
    </section>

    <section class="admin-stat-grid" aria-label="Resumen de la tienda">
      <a class="admin-stat-card" href="/admin/products"><span class="admin-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="M3 8v9l9 5 9-5V8M12 13v9"/></svg></span><span><span class="admin-stat-label">Productos</span><strong class="admin-stat-value"><%= productCount %></strong></span></a>
      <a class="admin-stat-card" href="/admin/categories"><span class="admin-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span><span><span class="admin-stat-label">Categorías</span><strong class="admin-stat-value"><%= categoryCount %></strong></span></a>
      <a class="admin-stat-card" href="/admin/reviews"><span class="admin-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9z"/></svg></span><span><span class="admin-stat-label">Reseñas</span><strong class="admin-stat-value"><%= reviewCount %></strong></span></a>
      <a class="admin-stat-card" href="/admin/orders"><span class="admin-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 4h2l2.2 11.1a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 1.9-1.4L22 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg></span><span><span class="admin-stat-label">Pedidos</span><strong class="admin-stat-value"><%= orderCount %></strong><small class="admin-stat-label"><%= pendingOrderCount %> pendientes</small></span></a>
      <div class="admin-stat-card"><span class="admin-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg></span><span><span class="admin-stat-label">Administradores</span><strong class="admin-stat-value"><%= adminCount %></strong></span></div>
    </section>

    <section class="admin-dashboard-card mb-6">
      <h3><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m13 2-3 9h7L8 22l3-9H4z"/></svg>Accesos rápidos</h3>
      <div class="admin-quick-grid">
        <a class="admin-quick-link is-primary" href="/admin/products/new"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/><rect x="3" y="3" width="18" height="18" rx="4"/></svg>Agregar producto</a>
        <a class="admin-quick-link" href="/admin/categories/new"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Agregar categoría</a>
        <a class="admin-quick-link" href="/admin/products"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>Ver productos</a>
        <a class="admin-quick-link" href="/admin/orders"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.2 11.1a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 1.9-1.4L22 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>Ver pedidos</a>
        <a class="admin-quick-link" href="/admin/reviews"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9z"/></svg>Moderar reseñas</a>
        <a class="admin-quick-link" href="/admin/settings"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19 13.5a7.5 7.5 0 0 0 0-3l2-1.5-2-3.5-2.4 1a7.5 7.5 0 0 0-2.6-1.5L13.5 2h-4L9 5a7.5 7.5 0 0 0-2.6 1.5L4 5.5 2 9l2 1.5a7.5 7.5 0 0 0 0 3L2 15l2 3.5 2.4-1A7.5 7.5 0 0 0 9 19l.5 3h4l.5-3a7.5 7.5 0 0 0 2.6-1.5l2.4 1 2-3.5z"/></svg>Configurar sitio</a>
      </div>
    </section>

    <section class="admin-dashboard-lower grid grid-cols-1 lg:grid-cols-2 gap-5">
      <article class="admin-dashboard-card">
        <h3><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5m0-8h.01"/></svg>Información del sitio</h3>
        <dl class="admin-site-details">
          <div><dt>Marca</dt><dd><%= siteSettings?.brandName || '—' %></dd></div>
          <div><dt>Eslogan</dt><dd><%= siteSettings?.slogan || '—' %></dd></div>
          <div><dt>Correo</dt><dd><%= siteSettings?.email || '—' %></dd></div>
          <div><dt>WhatsApp</dt><dd><%= siteSettings?.whatsapp || '—' %></dd></div>
        </dl>
      </article>
      <article class="admin-dashboard-card">
        <h3><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/></svg>Revisión pendiente</h3>
        <div class="admin-pending-list">
          <a href="/admin/orders"><span>Pedidos por revisar</span><strong><%= pendingOrderCount %></strong></a>
          <a href="/admin/reviews"><span>Reseñas por moderar</span><strong><%= pendingReviewCount %></strong></a>
        </div>
        <p class="admin-dashboard-note">Las cifras se actualizan con los registros actuales de la tienda.</p>
      </article>
    </section>
  </main>
  <%- include("../partials/admin-shell-end") %>
</body>
</html>
