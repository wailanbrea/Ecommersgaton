<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Admin | GATON DO</title>  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/admin-utilities.css">
</head>
<body class="min-h-screen bg-stone-100 flex items-center justify-center px-4">
  <div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8 border border-stone-200">
    <div class="text-center mb-8">
      <p class="text-sm uppercase tracking-[0.35em] text-stone-500">Panel Administrativo</p>
      <h1 class="mt-3 text-3xl font-semibold text-stone-900">GATON DO</h1>
      <p class="mt-2 text-stone-600">Ingresa para administrar tu e-commerce</p>
    </div>

    <% if (error) { %>
      <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm">
        <%= error %>
      </div>
    <% } %>

    <form method="post" action="/admin/login" class="space-y-5">
      <div>
        <label class="block text-sm font-medium text-stone-700 mb-2">Correo</label>
        <input
          type="email"
          name="email"
          required
          class="w-full rounded-xl border border-stone-300 px-4 py-3 outline-none focus:ring-2 focus:ring-stone-800"
          placeholder="admin@gatondo.com"
        >
      </div>

      <div>
        <label class="block text-sm font-medium text-stone-700 mb-2">Contraseña</label>
        <input
          type="password"
          name="password"
          required
          class="w-full rounded-xl border border-stone-300 px-4 py-3 outline-none focus:ring-2 focus:ring-stone-800"
          placeholder="********"
        >
      </div>

      <button
        type="submit"
        class="w-full rounded-xl bg-stone-900 hover:bg-stone-800 text-white py-3 font-medium transition">
        Entrar al panel
      </button>
    </form>

    <div class="mt-6 text-center text-sm text-stone-500">
      <a href="/" class="hover:underline">Volver a la tienda</a>
    </div>
  </div>
</body>
</html>