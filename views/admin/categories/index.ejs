<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Categorías | Admin</title>  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/admin-utilities.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-shell-body">
  <%- include("../../partials/admin-shell-start") %>
<main class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
      <div>
        <h2 class="text-3xl font-semibold text-stone-900">Categorías</h2>
        <p class="text-stone-600 mt-2">Administra las categorías del e-commerce.</p>
      </div>

      <div class="flex gap-3">
        <a href="/admin/dashboard" class="rounded-xl bg-white border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-50">
          Volver
        </a>
        <a href="/admin/categories/new" class="rounded-xl bg-stone-900 text-white px-4 py-2 text-sm font-medium hover:bg-stone-800">
          Nueva categoría
        </a>
      </div>
    </div>

    <div class="bg-white border border-stone-200 rounded-2xl shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-stone-50 border-b border-stone-200">
            <tr>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Nombre</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Slug</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Orden</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Estado</th>
              <th class="text-right px-4 py-3 font-semibold text-stone-700">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if (categories.length === 0) { %>
              <tr>
                <td colspan="5" class="px-4 py-8 text-center text-stone-500">
                  No hay categorías registradas.
                </td>
              </tr>
            <% } %>

            <% categories.forEach(category => { %>
              <tr class="border-b border-stone-100">
                <td class="px-4 py-3">
                  <div class="font-medium text-stone-900"><%= category.name %></div>
                  <div class="text-xs text-stone-500"><%= category.description || "" %></div>
                </td>
                <td class="px-4 py-3 text-stone-600"><%= category.slug %></td>
                <td class="px-4 py-3 text-stone-600"><%= category.sortOrder ?? 0 %></td>
                <td class="px-4 py-3">
                  <% if (category.active) { %>
                    <span class="inline-flex rounded-full bg-green-100 text-green-700 px-3 py-1 text-xs font-medium">Activa</span>
                  <% } else { %>
                    <span class="inline-flex rounded-full bg-red-100 text-red-700 px-3 py-1 text-xs font-medium">Inactiva</span>
                  <% } %>
                </td>
                <td class="px-4 py-3">
                  <div class="flex justify-end gap-2">
                    <a href="/admin/categories/<%= category._id %>/edit" class="rounded-lg bg-stone-900 text-white px-3 py-2 text-xs font-medium hover:bg-stone-800">
                      Editar
                    </a>
                    <form action="/admin/categories/<%= category._id %>/delete" method="post" onsubmit="return confirm('¿Eliminar esta categoría?');">
                      <button class="rounded-lg bg-red-600 text-white px-3 py-2 text-xs font-medium hover:bg-red-700">
                        Eliminar
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
  <%- include("../../partials/admin-shell-end") %>
</body>
</html>