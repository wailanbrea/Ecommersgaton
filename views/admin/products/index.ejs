<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Productos | Admin</title>  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/admin-utilities.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-shell-body">
  <%- include("../../partials/admin-shell-start") %>
<main class="max-w-7xl mx-auto px-4 py-8">
    <div class="mb-6 rounded-2xl bg-blue-50 border border-blue-200 text-blue-800 px-4 py-4 text-sm">
      Aquí puedes administrar el catálogo.
      Para agregar un producto nuevo usa el botón <strong>“Nuevo producto”</strong> o entra directo a:
      <strong>/admin/products/new</strong>
    </div>

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
      <div>
        <h2 class="text-3xl font-semibold text-stone-900">Productos</h2>
        <p class="text-stone-600 mt-2">Administra el catálogo del e-commerce.</p>
      </div>

      <div class="flex gap-3">
        <a href="/admin/dashboard" class="rounded-xl bg-white border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-50">
          Volver
        </a>
        <a href="/admin/products/new" class="rounded-xl bg-stone-900 text-white px-4 py-2 text-sm font-medium hover:bg-stone-800">
          Nuevo producto
        </a>
      </div>
    </div>

    <div class="bg-white border border-stone-200 rounded-2xl shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-stone-50 border-b border-stone-200">
            <tr>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Producto</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Categoría</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Precio</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Stock</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Estado</th>
              <th class="text-right px-4 py-3 font-semibold text-stone-700">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if (!products || products.length === 0) { %>
              <tr>
                <td colspan="6" class="px-4 py-8 text-center text-stone-500">
                  No hay productos registrados.
                </td>
              </tr>
            <% } %>

            <% if (products && products.length > 0) { %>
              <% products.forEach(function(product) { %>
                <tr class="border-b border-stone-100 align-top">
                  <td class="px-4 py-3">
                    <div class="font-medium text-stone-900"><%= product.name %></div>
                    <div class="text-xs text-stone-500 mt-1"><%= product.slug %></div>

                    <% if (product.hasVariants) { %>
                      <div class="text-xs text-blue-600 mt-1">Con variantes</div>
                    <% } %>

                    <% if (product.hasCustomization) { %>
                      <div class="text-xs text-amber-600 mt-1">Personalizable</div>
                    <% } %>
                  </td>

                  <td class="px-4 py-3 text-stone-600">
                    <%= (categoryMap && categoryMap[product.categoryId]) ? categoryMap[product.categoryId] : "Sin categoría" %>
                  </td>

                  <td class="px-4 py-3 text-stone-600">
                    RD$ <%= Number(product.basePrice || 0).toFixed(2) %>
                    <% if (product.compareAtPrice && product.compareAtPrice > product.basePrice) { %>
                      <div class="text-xs text-stone-400 line-through">
                        RD$ <%= Number(product.compareAtPrice || 0).toFixed(2) %>
                      </div>
                    <% } %>
                  </td>

                  <td class="px-4 py-3 text-stone-600"><%= product.stock || 0 %></td>

                  <td class="px-4 py-3">
                    <div class="flex flex-col gap-2">
                      <% if (product.active) { %>
                        <span class="inline-flex rounded-full bg-green-100 text-green-700 px-3 py-1 text-xs font-medium w-fit">Activo</span>
                      <% } else { %>
                        <span class="inline-flex rounded-full bg-red-100 text-red-700 px-3 py-1 text-xs font-medium w-fit">Inactivo</span>
                      <% } %>

                      <% if (product.outOfStock) { %>
                        <span class="inline-flex rounded-full bg-orange-100 text-orange-700 px-3 py-1 text-xs font-medium w-fit">Agotado</span>
                      <% } %>
                    </div>
                  </td>

                  <td class="px-4 py-3">
                    <div class="flex justify-end gap-2">
                      <a href="/admin/products/<%= product._id %>/personalization" class="inline-block rounded-lg bg-[#016B83] text-white px-3 py-2 text-xs font-medium mb-2">Personalización</a>
                    <a href="/admin/products/<%= product._id %>/edit" class="rounded-lg bg-stone-900 text-white px-3 py-2 text-xs font-medium hover:bg-stone-800">
                        Editar
                      </a>

                      <form action="/admin/products/<%= product._id %>/delete" method="post" onsubmit="return confirm('¿Eliminar este producto?');">
                        <input type="hidden" name="_csrf" value="<%= adminCsrfToken %>">
                        <button class="rounded-lg bg-red-600 text-white px-3 py-2 text-xs font-medium hover:bg-red-700">
                          Eliminar
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
  <%- include("../../partials/admin-shell-end") %>
</body>
</html>
