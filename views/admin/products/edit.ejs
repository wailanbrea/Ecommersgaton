<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar producto | Admin</title>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/admin-utilities.css">
  <link rel="stylesheet" href="/css/admin.css?v=2">
</head>
<body class="admin-shell-body">
  <%- include("../../partials/admin-shell-start") %>
<main class="max-w-6xl mx-auto px-4 py-8">
    <%- include("../../partials/admin-product-guide", { guideOpen: false }) %>
    <div class="mb-8">
      <h2 class="text-3xl font-semibold text-stone-900">Editar producto</h2>
      <p class="text-stone-600 mt-2">Formulario mejorado sin JSON manual.</p>
    </div>

    <% if (error) { %>
      <div class="mb-6 rounded-xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/products/<%= formData._id %>/edit" method="post" enctype="multipart/form-data" class="bg-white border border-stone-200 rounded-2xl p-6 shadow-sm space-y-8">
      <input type="hidden" name="_csrf" value="<%= adminCsrfToken %>">
      <section>
        <h3 class="text-xl font-semibold text-stone-900 mb-4">Información general</h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Nombre *</label>
            <input type="text" name="name" required value="<%= formData.name %>" class="w-full rounded-xl border border-stone-300 px-4 py-3">
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Slug</label>
            <input type="text" name="slug" value="<%= formData.slug %>" class="w-full rounded-xl border border-stone-300 px-4 py-3">
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Categorías (puedes elegir varias)</label>
            <%
              const selectedCategoryIds = new Set(
                (Array.isArray(formData.categoryIds) && formData.categoryIds.length ? formData.categoryIds : (formData.categoryId ? [formData.categoryId] : [])).map(String)
              );
            %>
            <div class="flex flex-wrap gap-2 rounded-xl border border-stone-300 bg-stone-50 p-3">
              <% categories.forEach(category => { %>
                <label class="inline-flex items-center gap-2 rounded-full border border-stone-300 bg-white px-3 py-1.5 text-sm text-stone-800 cursor-pointer hover:bg-stone-100">
                  <input type="checkbox" name="categoryIds" value="<%= category._id %>" <%= selectedCategoryIds.has(String(category._id)) ? "checked" : "" %> class="rounded border-stone-300">
                  <span><%= category.name %></span>
                </label>
              <% }) %>
            </div>
            <p class="text-xs text-stone-500 mt-2">Ej. marca «Brazaletes» y «Personalizados» para que la pieza aparezca en ambas categorías.</p>
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Género / público (puedes elegir varios)</label>
            <%
              const selectedGenders = new Set(
                (Array.isArray(formData.genders) && formData.genders.length ? formData.genders : (formData.gender ? [formData.gender] : [])).map(String)
              );
            %>
            <div class="flex flex-wrap gap-2 rounded-xl border border-stone-300 bg-stone-50 p-3">
              <% (genderOptions || []).filter(o => o.value).forEach(option => { %>
                <label class="inline-flex items-center gap-2 rounded-full border border-stone-300 bg-white px-3 py-1.5 text-sm text-stone-800 cursor-pointer hover:bg-stone-100">
                  <input type="checkbox" name="genders" value="<%= option.value %>" <%= selectedGenders.has(String(option.value)) ? "checked" : "" %> class="rounded border-stone-300">
                  <span><%= option.label %></span>
                </label>
              <% }) %>
            </div>
            <p class="text-xs text-stone-500 mt-2">Marca una o varias opciones (ej. Hombre y Mujer para piezas unisex), o déjalo vacío.</p>
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Tags (separados por coma)</label>
            <input type="text" name="tags" value="<%= formData.tags %>" class="w-full rounded-xl border border-stone-300 px-4 py-3">
          </div>
        </div>

        <div class="mt-6">
          <label class="block text-sm font-medium text-stone-700 mb-2">Descripción corta</label>
          <textarea name="shortDescription" rows="3" class="w-full rounded-xl border border-stone-300 px-4 py-3"><%= formData.shortDescription %></textarea>
        </div>

        <div class="mt-6">
          <label class="block text-sm font-medium text-stone-700 mb-2">Descripción completa</label>
          <textarea name="description" rows="5" class="w-full rounded-xl border border-stone-300 px-4 py-3"><%= formData.description %></textarea>
        </div>
      </section>

      <section>
        <h3 class="text-xl font-semibold text-stone-900 mb-4">Precio, stock y estado</h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Precio base</label>
            <input type="text" inputmode="decimal" name="basePrice" value="<%= formData.basePrice %>" placeholder="RD$1,200.00" class="w-full rounded-xl border border-stone-300 px-4 py-3">
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Precio de oferta (opcional)</label>
            <input type="text" inputmode="decimal" name="compareAtPrice" value="<%= formData.compareAtPrice %>" placeholder="Ej. 990.00" class="w-full rounded-xl border border-stone-300 px-4 py-3">
            <p class="mt-1 text-xs text-stone-500">Si es menor al precio base, se cobrará este precio de oferta y el precio base saldrá tachado.</p>
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-2">Stock</label>
            <input type="number" name="stock" value="<%= formData.stock %>" class="w-full rounded-xl border border-stone-300 px-4 py-3">
            <p class="mt-1 text-xs text-stone-500">Si marcas «Tiene variantes», déjalo en 0 y coloca el stock en cada variante.</p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-6">
          <label class="inline-flex items-center gap-3">
            <input type="checkbox" name="featured" <%= formData.featured ? "checked" : "" %>>
            <span class="text-sm text-stone-700">Destacado</span>
          </label>

          <label class="inline-flex items-center gap-3">
            <input type="checkbox" name="active" <%= formData.active ? "checked" : "" %>>
            <span class="text-sm text-stone-700">Activo</span>
          </label>

          <label class="inline-flex items-center gap-3">
            <input type="checkbox" name="outOfStock" <%= formData.outOfStock ? "checked" : "" %>>
            <span class="text-sm text-stone-700">Agotado</span>
          </label>

          <label class="inline-flex items-center gap-3">
            <input type="checkbox" name="hasVariants" <%= formData.hasVariants ? "checked" : "" %>>
            <span class="text-sm text-stone-700">Tiene variantes</span>
          </label>

          <label class="inline-flex items-center gap-3">
            <input type="checkbox" name="hasCustomization" id="hasCustomizationCheckbox" <%= formData.hasCustomization ? "checked" : "" %>>
            <span class="text-sm text-stone-700">Permite personalización</span>
          </label>
        </div>
      </section>

      <section>
        <h3 class="text-xl font-semibold text-stone-900 mb-4">Media</h3>

        <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 mb-5">
          Puedes subir archivos desde tu computadora. Si no subes nada, se conserva la URL escrita.
          Formatos permitidos: JPG, PNG, WEBP, GIF, MP4, WEBM y MOV.
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-3">
            <label class="block text-sm font-medium text-stone-700">Imagen principal</label>
            <input type="file" name="mainImageFile" accept="image/jpeg,image/png,image/webp,image/gif" class="w-full rounded-xl border border-stone-300 px-4 py-3 bg-white">
            <input type="text" name="mainImageUrl" value="<%= formData.mainImageUrl %>" placeholder="O pega/conserva una URL existente" class="w-full rounded-xl border border-stone-300 px-4 py-3">
            <% if (formData.mainImageUrl) { %>
              <div class="text-xs text-stone-500 break-all">Actual: <%= formData.mainImageUrl %></div>
            <% } %>
          </div>

          <div class="space-y-3">
            <label class="block text-sm font-medium text-stone-700">Video / GIF</label>
            <input type="file" name="videoFile" accept="video/mp4,video/webm,video/quicktime,image/gif" class="w-full rounded-xl border border-stone-300 px-4 py-3 bg-white">
            <input type="text" name="videoUrl" value="<%= formData.videoUrl %>" placeholder="O pega/conserva una URL existente" class="w-full rounded-xl border border-stone-300 px-4 py-3">
            <% if (formData.videoUrl) { %>
              <div class="text-xs text-stone-500 break-all">Actual: <%= formData.videoUrl %></div>
            <% } %>
          </div>
        </div>
      </section>

      <section>
        <div class="flex items-center justify-between gap-4 mb-4">
          <h3 class="text-xl font-semibold text-stone-900">Galería</h3>
          <button type="button" id="addGalleryBtn" class="rounded-xl bg-stone-900 text-white px-4 py-2 text-sm font-medium hover:bg-stone-800">
            Agregar URL
          </button>
        </div>

        <div id="galleryContainer" class="space-y-4">
          <% if (formData.gallery && formData.gallery.length) { %>
            <% formData.gallery.forEach((item) => { %>
              <div class="gallery-item bg-stone-50 border border-stone-200 rounded-2xl p-4">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div>
                    <label class="block text-sm font-medium mb-2">URL o ruta guardada</label>
                    <input type="text" name="galleryUrl" value="<%= item.url || '' %>" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Tipo</label>
                    <select name="galleryType" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                      <option value="image" <%= item.type === "image" ? "selected" : "" %>>Imagen</option>
                      <option value="video" <%= item.type === "video" ? "selected" : "" %>>Video</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Texto alternativo</label>
                    <input type="text" name="galleryAltText" value="<%= item.altText || '' %>" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                </div>
                <div class="mt-4">
                  <button type="button" class="remove-block rounded-xl bg-red-600 text-white px-4 py-2 text-sm">Quitar</button>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>

        <div class="mt-5 rounded-2xl border border-dashed border-stone-300 bg-stone-50 p-4">
          <label class="block text-sm font-medium text-stone-700 mb-2">Subir varias fotos / videos a la galería (frente, reverso, ángulos)</label>
          <input type="file" name="galleryFiles" multiple accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime" class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3">
          <p class="text-xs text-stone-500 mt-2">Puedes seleccionar varias imágenes a la vez (por ejemplo, fotos de cada lado de la pieza); se agregarán sin borrar las existentes.</p>
        </div>
      </section>

      <section>
        <div class="flex items-center justify-between gap-4 mb-4">
          <h3 class="text-xl font-semibold text-stone-900">Variantes</h3>
          <button type="button" id="addVariantBtn" class="rounded-xl bg-stone-900 text-white px-4 py-2 text-sm font-medium hover:bg-stone-800">
            Agregar variante manual
          </button>
        </div>
        <%- include("../../partials/admin-variant-builder") %>

        <div id="variantsContainer" class="space-y-4">
          <% if (formData.variants && formData.variants.length) { %>
            <% formData.variants.forEach((variant, index) => { %>
              <div class="variant-item bg-stone-50 border border-stone-200 rounded-2xl p-4">
                <input type="hidden" name="variantAttributesJson" value="<%= Array.isArray(variant.attributes) && variant.attributes.length ? JSON.stringify(variant.attributes) : '' %>">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div>
                    <label class="block text-sm font-medium mb-2">Nombre de la variante</label>
                    <input type="text" name="variantLabel" value="<%= variant.label || '' %>" placeholder="Ej. Dorado · 18 cm" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Tipo de opción</label>
                    <input type="text" name="variantOptionName" value="<%= variant.optionName || '' %>" placeholder="Color" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Valor de la opción</label>
                    <input type="text" name="variantOptionValue" value="<%= variant.optionValue || '' %>" placeholder="Dorado" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Segunda opción (opcional)</label>
                    <input type="text" name="variantOptionName2" value="<%= variant.optionName2 || '' %>" placeholder="Tamaño" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Valor 2 (opcional)</label>
                    <input type="text" name="variantOptionValue2" value="<%= variant.optionValue2 || '' %>" placeholder="18 cm" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Precio</label>
                    <input type="text" inputmode="decimal" name="variantPrice" value="<%= variant.price || 0 %>" placeholder="RD$1,200.00" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Precio anterior / oferta</label>
                    <input type="text" inputmode="decimal" name="variantCompareAtPrice" value="<%= variant.compareAtPrice || 0 %>" placeholder="RD$1,500.00" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Stock</label>
                    <input type="number" name="variantStock" value="<%= variant.stock || 0 %>" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div class="md:col-span-2">
                    <label class="block text-sm font-medium mb-2">Imagen de la variante</label>
                    <input type="hidden" name="variantImageUrl" value="<%= variant.imageUrl || '' %>">
                    <input type="file" name="variantImageFile<%= index %>" accept="image/*" data-upload-prefix="variantImageFile" class="w-full rounded-xl border border-stone-300 px-4 py-3 bg-white">
                    <% if (variant.imageUrl) { %>
                      <p class="text-xs text-stone-500 mt-2">Imagen actual: <%= variant.imageUrl %></p>
                    <% } %>
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Estado</label>
                    <select name="variantOutOfStock" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                      <option value="false" <%= !variant.outOfStock ? "selected" : "" %>>Disponible</option>
                      <option value="true" <%= variant.outOfStock ? "selected" : "" %>>Agotada</option>
                    </select>
                  </div>
                </div>
                <div class="mt-4">
                  <button type="button" class="remove-block rounded-xl bg-red-600 text-white px-4 py-2 text-sm">Quitar</button>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </section>

      <section>
        <div class="flex items-center justify-between gap-4 mb-4">
          <h3 class="text-xl font-semibold text-stone-900">Campos de personalización</h3>
          <button type="button" id="addCustomFieldBtn" class="rounded-xl bg-stone-900 text-white px-4 py-2 text-sm font-medium hover:bg-stone-800">
            Agregar campo
          </button>
        </div>

        <p class="text-sm text-stone-600 mb-4">Para joyas con varias caras, agrega un campo por cada una y nómbralo, por ejemplo, “Grabado frontal” y “Grabado posterior”. El cliente tendrá una vista previa independiente para cada texto.</p>

        <div class="mb-5 rounded-2xl border border-amber-200 bg-amber-50/70 p-4">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" name="allowPhotoCustomization" id="allowPhotoCustomizationCheckbox" <%= formData.allowPhotoCustomization ? "checked" : "" %> class="mt-1 rounded border-stone-300">
            <span>
              <strong class="block text-sm font-semibold text-stone-900">Permitir carga de imágenes del cliente (Fotograbado)</strong>
              <span class="block text-xs text-stone-600 mt-0.5">Habilita en la tienda la casilla para que el cliente adjunte hasta 6 fotos (JPG, PNG o WEBP), por ejemplo una imagen por cada lado de la joya.</span>
            </span>
          </label>
        </div>

        <div id="customFieldsContainer" class="space-y-4">
          <% if (formData.customizationFields && formData.customizationFields.length) { %>
            <% formData.customizationFields.forEach((field) => { %>
              <div class="custom-item bg-stone-50 border border-stone-200 rounded-2xl p-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-medium mb-2">Identificador interno</label>
                    <input type="text" name="customKey" value="<%= field.key || '' %>" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Nombre de la variante</label>
                    <input type="text" name="customLabel" value="<%= field.label || '' %>" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Ejemplo dentro del campo</label>
                    <input type="text" name="customPlaceholder" value="<%= field.placeholder || '' %>" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Máximo caracteres</label>
                    <input type="number" name="customMaxLength" value="<%= field.maxLength || 100 %>" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Costo adicional (RD$)</label>
                    <input type="number" name="customPriceDelta" min="0" max="1000000" step="0.01" value="<%= (Number(field.priceDeltaMinor || 0) / 100).toFixed(2) %>" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                    <p class="mt-1 text-xs text-stone-500">Se suma solo cuando el cliente completa este campo. Usa 0 para incluirlo.</p>
                  </div>
                  <div class="flex items-end">
                    <label class="inline-flex items-center gap-3">
                      <input type="hidden" name="customRequired" value="false">
                      <input type="checkbox" name="customRequired" value="true" <%= field.required ? "checked" : "" %>>
                      <span class="text-sm">Obligatorio</span>
                    </label>
                  </div>
                </div>
                <div class="mt-4">
                  <button type="button" class="remove-block rounded-xl bg-red-600 text-white px-4 py-2 text-sm">Quitar</button>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </section>

      <section>
        <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
          <h3 class="text-xl font-semibold text-stone-900">Tipografías</h3>
          <div class="flex flex-wrap items-center gap-2">
            <a href="/admin/settings#defaultFontsSection" target="_blank" rel="noopener" class="text-xs font-medium text-[#016B83] hover:underline mr-1">
              Editar predeterminadas →
            </a>
            <button type="button" id="loadPresetFontsBtn" class="rounded-xl bg-white border border-stone-300 text-stone-800 px-4 py-2 text-sm font-medium hover:bg-stone-50">
              Cargar tipografías predeterminadas
            </button>
            <button type="button" id="addFontBtn" class="rounded-xl bg-stone-900 text-white px-4 py-2 text-sm font-medium hover:bg-stone-800">
              Agregar tipografía
            </button>
          </div>
        </div>
        <p class="text-sm text-stone-600 mb-4">Activa o desactiva cada tipografía para este producto sin tener que borrarla. Puedes usar las fuentes integradas o subir tu propio archivo (<code>.ttf</code>, <code>.otf</code>, <code>.woff2</code>, <code>.woff</code>).</p>

        <div id="fontsContainer" class="space-y-4">
          <% if (formData.fontOptions && formData.fontOptions.length) { %>
            <% formData.fontOptions.forEach((font, index) => { %>
              <div class="font-item bg-stone-50 border border-stone-200 rounded-2xl p-4">
                <div class="flex items-center justify-between gap-3 mb-3 pb-3 border-b border-stone-200">
                  <label class="inline-flex items-center gap-2 text-sm font-medium text-stone-800 cursor-pointer">
                    <input type="hidden" name="fontActive" value="false">
                    <input type="checkbox" name="fontActive" value="true" <%= font.active !== false ? "checked" : "" %> class="rounded border-stone-300">
                    <span>Activa en este producto</span>
                  </label>
                  <button type="button" class="remove-block rounded-xl bg-red-600 text-white px-3 py-1.5 text-xs font-medium">Quitar</button>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-medium mb-2">Nombre</label>
                    <input type="text" name="fontName" value="<%= font.name || '' %>" placeholder="Ej. Dancing Script o Mi Fuente" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Texto de vista previa</label>
                    <input type="text" name="fontPreviewText" value="<%= font.previewText || '' %>" placeholder="Aa" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Archivo de fuente (.ttf, .otf, .woff2)</label>
                    <input type="hidden" name="fontFileUrl" value="<%= font.fontFileUrl || '' %>">
                    <input type="file" name="fontFile<%= index %>" accept=".ttf,.otf,.woff2,.woff" data-upload-prefix="fontFile" class="w-full rounded-xl border border-stone-300 px-4 py-3 bg-white">
                    <% if (font.fontFileUrl) { %>
                      <p class="text-xs text-stone-500 mt-2">Fuente actual: <%= font.fontFileUrl %></p>
                    <% } %>
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-2">Imagen de vista previa (opcional)</label>
                    <input type="hidden" name="fontPreviewImageUrl" value="<%= font.previewImageUrl || '' %>">
                    <input type="file" name="fontPreviewImageFile<%= index %>" accept="image/*" data-upload-prefix="fontPreviewImageFile" class="w-full rounded-xl border border-stone-300 px-4 py-3 bg-white">
                    <% if (font.previewImageUrl) { %>
                      <p class="text-xs text-stone-500 mt-2">Imagen actual: <%= font.previewImageUrl %></p>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </section>

      <div class="flex flex-wrap gap-3">
        <a href="/admin/products" class="rounded-xl bg-white border border-stone-300 px-5 py-3 text-sm font-medium hover:bg-stone-50">
          Cancelar
        </a>
        <button type="submit" class="rounded-xl bg-stone-900 text-white px-5 py-3 text-sm font-medium hover:bg-stone-800">
          Guardar cambios
        </button>
      </div>
    </form>
  </main>

  <template id="galleryTemplate">
    <div class="gallery-item bg-stone-50 border border-stone-200 rounded-2xl p-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-sm font-medium mb-2">URL o ruta guardada</label>
          <input type="text" name="galleryUrl" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Tipo</label>
          <select name="galleryType" class="w-full rounded-xl border border-stone-300 px-4 py-3">
            <option value="image">Imagen</option>
            <option value="video">Video</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Texto alternativo</label>
          <input type="text" name="galleryAltText" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
      </div>
      <div class="mt-4">
        <button type="button" class="remove-block rounded-xl bg-red-600 text-white px-4 py-2 text-sm">Quitar</button>
      </div>
    </div>
  </template>

  <template id="variantTemplate">
    <div class="variant-item bg-stone-50 border border-stone-200 rounded-2xl p-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-sm font-medium mb-2">Nombre de la variante</label>
          <input type="text" name="variantLabel" placeholder="Ej. Dorado · 18 cm" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Tipo de opción</label>
          <input type="text" name="variantOptionName" placeholder="Color" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Valor de la opción</label>
          <input type="text" name="variantOptionValue" placeholder="Dorado" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Segunda opción (opcional)</label>
          <input type="text" name="variantOptionName2" placeholder="Tamaño" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Valor 2 (opcional)</label>
          <input type="text" name="variantOptionValue2" placeholder="18 cm" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Precio</label>
          <input type="text" inputmode="decimal" name="variantPrice" value="0" placeholder="RD$1,200.00" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Precio anterior / oferta</label>
          <input type="text" inputmode="decimal" name="variantCompareAtPrice" value="0" placeholder="RD$1,500.00" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Stock</label>
          <input type="number" name="variantStock" value="0" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div class="md:col-span-2">
          <label class="block text-sm font-medium mb-2">Imagen de la variante</label>
          <input type="hidden" name="variantImageUrl">
          <input type="file" name="variantImageFile0" accept="image/*" data-upload-prefix="variantImageFile" class="w-full rounded-xl border border-stone-300 px-4 py-3 bg-white">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Estado</label>
          <select name="variantOutOfStock" class="w-full rounded-xl border border-stone-300 px-4 py-3">
            <option value="false" selected>Disponible</option>
            <option value="true">Agotada</option>
          </select>
        </div>
      </div>
      <div class="mt-4">
        <button type="button" class="remove-block rounded-xl bg-red-600 text-white px-4 py-2 text-sm">Quitar</button>
      </div>
    </div>
  </template>

  <template id="customTemplate">
    <div class="custom-item bg-stone-50 border border-stone-200 rounded-2xl p-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-2">Identificador interno</label>
          <input type="text" name="customKey" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Nombre de la variante</label>
          <input type="text" name="customLabel" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Ejemplo dentro del campo</label>
          <input type="text" name="customPlaceholder" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Máximo caracteres</label>
          <input type="number" name="customMaxLength" value="100" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Costo adicional (RD$)</label>
          <input type="number" name="customPriceDelta" min="0" max="1000000" step="0.01" value="0.00" class="w-full rounded-xl border border-stone-300 px-4 py-3">
          <p class="mt-1 text-xs text-stone-500">Se suma solo cuando el cliente completa este campo. Usa 0 para incluirlo.</p>
        </div>
        <div class="flex items-end">
          <label class="inline-flex items-center gap-3">
            <input type="hidden" name="customRequired" value="false">
            <input type="checkbox" name="customRequired" value="true">
            <span class="text-sm">Obligatorio</span>
          </label>
        </div>
      </div>
      <div class="mt-4">
        <button type="button" class="remove-block rounded-xl bg-red-600 text-white px-4 py-2 text-sm">Quitar</button>
      </div>
    </div>
  </template>

  <template id="fontTemplate">
    <div class="font-item bg-stone-50 border border-stone-200 rounded-2xl p-4">
      <div class="flex items-center justify-between gap-3 mb-3 pb-3 border-b border-stone-200">
        <label class="inline-flex items-center gap-2 text-sm font-medium text-stone-800 cursor-pointer">
          <input type="hidden" name="fontActive" value="false">
          <input type="checkbox" name="fontActive" value="true" checked class="rounded border-stone-300">
          <span>Activa en este producto</span>
        </label>
        <button type="button" class="remove-block rounded-xl bg-red-600 text-white px-3 py-1.5 text-xs font-medium">Quitar</button>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-2">Nombre</label>
          <input type="text" name="fontName" placeholder="Ej. Dancing Script o Mi Fuente" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Texto de vista previa</label>
          <input type="text" name="fontPreviewText" value="Aa" placeholder="Aa" class="w-full rounded-xl border border-stone-300 px-4 py-3">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Archivo de fuente (.ttf, .otf, .woff2)</label>
          <input type="hidden" name="fontFileUrl">
          <input type="file" name="fontFile0" accept=".ttf,.otf,.woff2,.woff" data-upload-prefix="fontFile" class="w-full rounded-xl border border-stone-300 px-4 py-3 bg-white">
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Imagen de vista previa (opcional)</label>
          <input type="hidden" name="fontPreviewImageUrl">
          <input type="file" name="fontPreviewImageFile0" accept="image/*" data-upload-prefix="fontPreviewImageFile" class="w-full rounded-xl border border-stone-300 px-4 py-3 bg-white">
        </div>
      </div>
    </div>
  </template>

  <script>
    function refreshUploadIndexes() {
      document.querySelectorAll(".variant-item").forEach(function (item, index) {
        item.querySelectorAll('[data-upload-prefix="variantImageFile"]').forEach(function (input) {
          input.name = "variantImageFile" + index;
        });
      });

      document.querySelectorAll(".font-item").forEach(function (item, index) {
        item.querySelectorAll('[data-upload-prefix="fontPreviewImageFile"]').forEach(function (input) {
          input.name = "fontPreviewImageFile" + index;
        });
        item.querySelectorAll('[data-upload-prefix="fontFile"]').forEach(function (input) {
          input.name = "fontFile" + index;
        });
      });
    }

    function appendTemplate(templateId, containerId) {
      const template = document.getElementById(templateId);
      const container = document.getElementById(containerId);
      const clone = template.content.cloneNode(true);
      container.appendChild(clone);
      refreshUploadIndexes();
    }

    document.getElementById("addGalleryBtn").addEventListener("click", function () {
      appendTemplate("galleryTemplate", "galleryContainer");
    });

    document.getElementById("addVariantBtn").addEventListener("click", function () {
      appendTemplate("variantTemplate", "variantsContainer");
    });

    document.getElementById("addCustomFieldBtn").addEventListener("click", function () {
      appendTemplate("customTemplate", "customFieldsContainer");
    });

    document.getElementById("addFontBtn").addEventListener("click", function () {
      appendTemplate("fontTemplate", "fontsContainer");
    });

    document.getElementById("loadPresetFontsBtn").addEventListener("click", function () {
      const presets = <%- JSON.stringify(typeof defaultPresetFonts !== "undefined" ? defaultPresetFonts : []).replace(/[<>&\u2028\u2029]/g, (c) => ({ "<": "\\u003c", ">": "\\u003e", "&": "\\u0026", "\u2028": "\\u2028", "\u2029": "\\u2029" })[c]) %>;
      const existing = new Set(
        Array.from(document.querySelectorAll('#fontsContainer input[name="fontName"]'))
          .map(function (el) { return (el.value || "").trim().toLowerCase(); })
          .filter(Boolean)
      );
      presets.forEach(function (preset) {
        const presetName = String(preset?.name || "").trim();
        if (!presetName || existing.has(presetName.toLowerCase())) return;
        const template = document.getElementById("fontTemplate");
        const clone = template.content.cloneNode(true);
        const nameInput = clone.querySelector('input[name="fontName"]');
        const previewInput = clone.querySelector('input[name="fontPreviewText"]');
        const fontFileHidden = clone.querySelector('input[name="fontFileUrl"]');
        const previewImgHidden = clone.querySelector('input[name="fontPreviewImageUrl"]');
        const activeCheckbox = clone.querySelector('input[type="checkbox"][name="fontActive"]');
        if (nameInput) nameInput.value = presetName;
        if (previewInput && preset.previewText) previewInput.value = preset.previewText;
        if (fontFileHidden && preset.fontFileUrl) {
          fontFileHidden.value = preset.fontFileUrl;
          const note = document.createElement("p");
          note.className = "text-xs text-stone-500 mt-2";
          note.textContent = "Fuente actual: " + preset.fontFileUrl;
          fontFileHidden.parentElement.appendChild(note);
        }
        if (previewImgHidden && preset.previewImageUrl) {
          previewImgHidden.value = preset.previewImageUrl;
          const note = document.createElement("p");
          note.className = "text-xs text-stone-500 mt-2";
          note.textContent = "Imagen actual: " + preset.previewImageUrl;
          previewImgHidden.parentElement.appendChild(note);
        }
        if (activeCheckbox) activeCheckbox.checked = preset.active !== false;
        document.getElementById("fontsContainer").appendChild(clone);
      });
      refreshUploadIndexes();
    });

    document.addEventListener("click", function (e) {
      if (e.target.classList.contains("remove-block")) {
        const block = e.target.closest(".gallery-item, .variant-item, .custom-item, .font-item");
        if (block) {
          block.remove();
          refreshUploadIndexes();
        }
      }
    });

    document.getElementById("allowPhotoCustomizationCheckbox")?.addEventListener("change", function () {
      const custCb = document.querySelector('input[name="hasCustomization"]');
      if (this.checked && custCb) custCb.checked = true;
    });

    refreshUploadIndexes();
  </script>
  <script src="/js/admin-variant-builder.js?v=2" defer></script>
  <%- include("../../partials/admin-shell-end") %>
</body>
</html>
