<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  >
  <title>Personalización | Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="bg-stone-100 min-h-screen">
  <%- include("../../partials/admin-header") %>

  <main class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex flex-wrap justify-between gap-4 mb-7">
      <div>
        <p
          class="text-xs uppercase tracking-[.3em] text-[#016B83]"
        >
          Personalización avanzada
        </p>
        <h1 class="text-3xl font-semibold mt-2">
          <%= product.name %>
        </h1>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href="/product/<%= product.slug %>"
          target="_blank"
          class="rounded-xl bg-[#016B83] text-white px-4 py-3 text-sm"
        >
          Ver producto
        </a>
        <a
          href="/admin/products"
          class="rounded-xl bg-stone-900 text-white px-4 py-3 text-sm"
        >
          Volver
        </a>
      </div>
    </div>

    <% if (saved) { %>
      <div
        class="mb-5 rounded-xl bg-green-50 border border-green-200 text-green-700 px-4 py-3"
      >
        Configuración guardada.
      </div>
    <% } %>

    <% if (error) { %>
      <div
        class="mb-5 rounded-xl bg-red-50 border border-red-200 text-red-700 px-4 py-3"
      >
        <%= error %>
      </div>
    <% } %>

    <%
      const configJson = JSON
        .stringify(advancedConfig || {})
        .replace(/</g, "\\u003c");
    %>

    <form
      method="post"
      action="/admin/products/<%= product._id %>/personalization"
      data-personalization-form
      class="space-y-6"
    >
      <textarea
        name="advancedConfigJson"
        data-config-json
        hidden
      ><%- configJson %></textarea>

      <section
        class="bg-white rounded-3xl border border-stone-200 p-6"
      >
        <h2 class="text-xl font-semibold mb-5">
          Vista previa y archivo
        </h2>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          <div class="bg-stone-50 rounded-2xl p-5">
            <label class="flex items-center gap-3">
              <input
                type="checkbox"
                data-global="engravingPreviewEnabled"
                <%= advancedConfig.engravingPreviewEnabled
                  ? "checked"
                  : "" %>
              >
              <span>Mostrar vista previa del grabado</span>
            </label>

            <input
              type="text"
              data-global="engravingPreviewLabel"
              value="<%= advancedConfig.engravingPreviewLabel || '' %>"
              class="mt-4 w-full rounded-xl border px-4 py-3"
              placeholder="Vista previa del grabado"
            >
          </div>

          <div class="bg-stone-50 rounded-2xl p-5">
            <div class="flex flex-wrap gap-5">
              <label class="flex items-center gap-3">
                <input
                  type="checkbox"
                  data-global="customizationUploadEnabled"
                  <%= advancedConfig.customizationUploadEnabled
                    ? "checked"
                    : "" %>
                >
                <span>Permitir subir diseño</span>
              </label>

              <label class="flex items-center gap-3">
                <input
                  type="checkbox"
                  data-global="customizationUploadRequired"
                  <%= advancedConfig.customizationUploadRequired
                    ? "checked"
                    : "" %>
                >
                <span>Obligatorio</span>
              </label>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-4">
              <input
                type="text"
                data-global="customizationUploadLabel"
                value="<%= advancedConfig.customizationUploadLabel || '' %>"
                class="rounded-xl border px-4 py-3"
                placeholder="Sube tu diseño"
              >
              <input
                type="number"
                min="1"
                max="20"
                data-global="customizationUploadMaxSizeMB"
                value="<%= advancedConfig.customizationUploadMaxSizeMB || 20 %>"
                class="rounded-xl border px-4 py-3"
              >
            </div>

            <input
              type="text"
              data-global="customizationUploadHelp"
              value="<%= advancedConfig.customizationUploadHelp || '' %>"
              class="mt-3 w-full rounded-xl border px-4 py-3"
              placeholder="PNG, JPG, SVG, PDF o AI..."
            >
          </div>
        </div>
      </section>

      <section
        class="bg-white rounded-3xl border border-stone-200 p-6"
      >
        <div class="flex justify-between gap-4 mb-5">
          <div>
            <h2 class="text-xl font-semibold">
              Grupos de opciones
            </h2>
            <p class="text-sm text-stone-500">
              Color, medida, tamaño o acabado.
            </p>
          </div>

          <button
            type="button"
            data-add-group
            class="rounded-xl bg-[#016B83] text-white px-4 py-2"
          >
            Agregar grupo
          </button>
        </div>

        <div data-groups class="space-y-4"></div>
      </section>

      <section
        class="bg-white rounded-3xl border border-stone-200 p-6"
      >
        <div class="flex justify-between gap-4 mb-5">
          <h2 class="text-xl font-semibold">
            Campos de texto
          </h2>
          <button
            type="button"
            data-add-field
            class="rounded-xl bg-stone-900 text-white px-4 py-2"
          >
            Agregar campo
          </button>
        </div>
        <div data-fields class="space-y-3"></div>
      </section>

      <section
        class="bg-white rounded-3xl border border-stone-200 p-6"
      >
        <div class="flex justify-between gap-4 mb-5">
          <h2 class="text-xl font-semibold">
            Tipografías
          </h2>
          <button
            type="button"
            data-add-font
            class="rounded-xl bg-stone-900 text-white px-4 py-2"
          >
            Agregar tipografía
          </button>
        </div>
        <div data-fonts class="space-y-3"></div>
      </section>

      <section
        class="bg-white rounded-3xl border border-stone-200 p-6"
      >
        <h2 class="text-xl font-semibold mb-2">
          Nombres de las vistas
        </h2>
        <p class="text-sm text-stone-500 mb-5">
          Vista 1, Vista 2, Vista 3 o nombres descriptivos.
        </p>
        <div data-gallery class="space-y-3"></div>
      </section>

      <div
        class="sticky bottom-4 bg-white border rounded-2xl p-4 shadow-xl text-right"
      >
        <button
          type="submit"
          class="rounded-xl bg-[#016B83] text-white px-6 py-3 font-semibold"
        >
          Guardar personalización
        </button>
      </div>
    </form>
  </main>

  <script
    src="/js/admin-product-personalization.js?v=3c1b"
    defer
  ></script>
</body>
</html>
