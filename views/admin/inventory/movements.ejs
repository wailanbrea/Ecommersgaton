<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Movimientos de inventario | GATÓN DO</title><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/admin-utilities.css"><link rel="stylesheet" href="/css/admin.css"></head><body class="admin-shell-body"><%- include("../../partials/admin-shell-start") %><main class="admin-tool-page"><header class="admin-tool-heading"><a class="admin-tool-button secondary" href="/admin/inventory">Volver a inventario</a></header><section class="admin-tool-card"><div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th>Fecha</th><th>Producto</th><th>Acción</th><th>Antes</th><th>Después</th><th>Variación</th><th>Lote</th></tr></thead><tbody><% movements.forEach((m)=>{ %><tr><td><%= new Date(m.created_at).toLocaleString('es-DO',{timeZone:'America/Santo_Domingo'}) %></td><td><%= m.product_name %></td><td><%= m.action %></td><td><%= m.quantity_before %></td><td><%= m.quantity_after %></td><td><%= m.quantity_delta > 0 ? '+' : '' %><%= m.quantity_delta %></td><td><%= m.batch_id %></td></tr><% }) %><% if(!movements.length){ %><tr><td colspan="7">Todavía no hay movimientos.</td></tr><% } %></tbody></table></div></section></main><%- include("../../partials/admin-shell-end") %></body></html>
