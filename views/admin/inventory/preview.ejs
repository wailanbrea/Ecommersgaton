<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vista previa de inventario | GATÓN DO</title><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/admin-utilities.css"><link rel="stylesheet" href="/css/admin.css"></head><body class="admin-shell-body"><%- include("../../partials/admin-shell-start") %><main class="admin-tool-page"><header class="admin-tool-heading"><a class="admin-tool-button secondary" href="/admin/inventory">Cancelar</a></header><section class="admin-tool-card"><div class="admin-alert warning">Se actualizarán <strong><%= rows.length %></strong> líneas. El proceso vuelve a verificar que los datos no hayan cambiado desde esta vista previa.</div><div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th>Producto</th><th>Variante</th><th>Antes</th><th>Nuevo stock</th><th>Diferencia</th></tr></thead><tbody><% rows.forEach((r)=>{ %><tr><td><%= r.productName %></td><td><%= r.variantSignature || 'Producto base' %></td><td><%= r.before %></td><td><strong><%= r.stock %></strong></td><td><%= r.delta > 0 ? '+' : '' %><%= r.delta %></td></tr><% }) %></tbody></table></div><form method="post" action="/admin/inventory/import/apply" class="admin-tool-actions"><input type="hidden" name="_csrf" value="<%= adminCsrfToken %>"><input type="hidden" name="token" value="<%= token %>"><button type="submit" class="admin-tool-button primary">Confirmar importación</button><a class="admin-tool-button secondary" href="/admin/inventory">Volver sin guardar</a></form></section></main><%- include("../../partials/admin-shell-end") %></body></html>
