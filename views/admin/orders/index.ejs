<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pedidos | Admin</title>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/admin-utilities.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .ord-page { max-width: 1280px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; display: flex; flex-direction: column; gap: 1rem; }
    .ord-toolbar-card { background: #fff; border: 1px solid #e7e5e4; border-radius: 1.1rem; padding: 1rem 1.15rem; box-shadow: 0 1px 3px rgba(28,25,23,.04); display: flex; flex-direction: column; gap: .85rem; }
    .ord-toolbar-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: .65rem; }
    .ord-filter-field { display: flex; flex-direction: column; gap: .25rem; }
    .ord-filter-field label { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: #78716c; }
    .ord-filter-input, .ord-filter-select { border: 1px solid #d6d3d1; border-radius: .65rem; padding: .5rem .75rem; font-size: .84rem; color: #1c1917; background: #fff; }
    .ord-filter-input:focus, .ord-filter-select:focus { outline: 2px solid #292524; outline-offset: 1px; border-color: #292524; }
    .ord-search-wrap { flex: 1 1 230px; }
    .ord-search-wrap input { width: 100%; box-sizing: border-box; }
    .ord-status-pills { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; }
    .ord-pill-btn { border: 1px solid #d6d3d1; background: #fff; color: #44403c; border-radius: 999px; padding: .36rem .78rem; font-size: .78rem; font-weight: 600; cursor: pointer; white-space: nowrap; transition: all .15s ease; }
    .ord-pill-btn:hover { background: #f5f5f4; }
    .ord-pill-btn.is-active { background: #1c1917; color: #fff; border-color: #1c1917; }
    .ord-toolbar-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .6rem; padding-top: .65rem; border-top: 1px solid #f5f5f4; font-size: .8rem; color: #78716c; }
    .ord-meta-actions { display: flex; flex-wrap: wrap; gap: .45rem; }
    .ord-mini-btn { border: 1px solid #d6d3d1; background: #fff; color: #44403c; border-radius: .55rem; padding: .3rem .65rem; font-size: .76rem; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .ord-mini-btn:hover { background: #f5f5f4; }

    .ord-list { display: flex; flex-direction: column; gap: .6rem; }
    .ord-card { background: #fff; border: 1px solid #e7e5e4; border-radius: 1rem; box-shadow: 0 1px 2px rgba(28,25,23,.04); overflow: hidden; transition: border-color .15s ease, box-shadow .15s ease; }
    .ord-card[open] { border-color: #a8a29e; box-shadow: 0 6px 20px rgba(28,25,23,.07); }
    .ord-card[hidden] { display: none !important; }
    .ord-summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 44px minmax(115px, 145px) minmax(170px, 1.1fr) minmax(180px, 1.3fr) auto auto 28px; align-items: center; gap: .85rem; padding: .75rem 1rem; user-select: none; }
    .ord-summary::-webkit-details-marker { display: none; }
    .ord-summary:hover { background: #fafaf9; }
    @media (max-width: 960px) {
      .ord-summary { grid-template-columns: 44px 1fr auto 24px; gap: .6rem .75rem; }
      .ord-sum-prod, .ord-sum-date { display: none; }
    }
    .ord-sum-thumb { width: 44px; height: 44px; border-radius: .6rem; object-fit: cover; border: 1px solid #e7e5e4; background: #fafaf9; }
    .ord-sum-thumb-empty { width: 44px; height: 44px; border-radius: .6rem; border: 1px dashed #d6d3d1; background: #fafaf9; color: #a8a29e; display: flex; align-items: center; justify-content: center; font-size: .64rem; font-weight: 600; text-align: center; }
    .ord-sum-id { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 800; font-size: .88rem; color: #1c1917; white-space: nowrap; }
    .ord-sum-date { font-size: .74rem; color: #78716c; margin-top: .1rem; white-space: nowrap; }
    .ord-sum-customer { font-weight: 700; font-size: .88rem; color: #1c1917; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ord-sum-phone { font-size: .76rem; color: #78716c; }
    .ord-sum-prod { font-size: .83rem; color: #44403c; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ord-sum-prod small { display: block; font-size: .74rem; color: #78716c; }
    .ord-sum-total { font-size: .92rem; font-weight: 800; color: #1c1917; font-variant-numeric: tabular-nums; white-space: nowrap; text-align: right; }
    .ord-chevron { width: 24px; height: 24px; border-radius: 999px; background: #f5f5f4; color: #57534e; display: inline-flex; align-items: center; justify-content: center; font-size: .75rem; transition: transform .18s ease, background .15s ease; }
    .ord-card[open] .ord-chevron { transform: rotate(180deg); background: #1c1917; color: #fff; }

    .ord-detail { padding: 1.2rem 1.35rem 1.35rem; border-top: 1px solid #e7e5e4; background: #fff; }
    .ord-grid { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: 1.4rem; align-items: start; }
    @media (max-width: 980px) { .ord-grid { grid-template-columns: 1fr; } }
    .ord-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; padding-bottom: .85rem; border-bottom: 1px solid #f5f5f4; margin-bottom: .9rem; }
    .ord-id-wrap { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
    .ord-title { font-size: 1.05rem; font-weight: 800; color: #1c1917; margin: 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
    .ord-date { font-size: .78rem; color: #78716c; }
    .ord-status { display: inline-flex; align-items: center; border-radius: 999px; padding: .24rem .68rem; font-size: .73rem; font-weight: 700; white-space: nowrap; }
    .ord-status--pending { background: #fef3c7; color: #92400e; }
    .ord-status--confirmed { background: #dbeafe; color: #1e40af; }
    .ord-status--processing { background: #ede9fe; color: #5b21b6; }
    .ord-status--completed { background: #dcfce7; color: #166534; }
    .ord-status--cancelled { background: #fee2e2; color: #991b1b; }
    .ord-customer-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem 1.25rem; background: #fafaf9; border: 1px solid #f0efed; border-radius: .9rem; padding: .85rem 1rem; margin-bottom: 1rem; font-size: .85rem; }
    @media (max-width: 640px) { .ord-customer-grid { grid-template-columns: 1fr; } }
    .ord-customer-item span { display: block; font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; color: #78716c; font-weight: 700; margin-bottom: .1rem; }
    .ord-customer-item strong { color: #1c1917; font-weight: 600; word-break: break-word; }
    .ord-items-list { display: flex; flex-direction: column; gap: .85rem; }
    .ord-item-card { border: 1px solid #e7e5e4; border-radius: 1rem; padding: .95rem; background: #fff; }
    .ord-item-top { display: flex; align-items: flex-start; gap: 1rem; }
    .ord-thumb { width: 76px; height: 76px; border-radius: .85rem; object-fit: cover; border: 1px solid #e7e5e4; background: #fafaf9; flex-shrink: 0; }
    .ord-thumb-empty { width: 76px; height: 76px; border-radius: .85rem; border: 1px dashed #d6d3d1; background: #fafaf9; color: #a8a29e; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: .72rem; font-weight: 600; text-align: center; }
    .ord-item-info { flex: 1; min-width: 0; }
    .ord-item-header { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: .5rem; }
    .ord-item-name { font-size: .98rem; font-weight: 700; color: #1c1917; margin: 0; }
    .ord-item-price { font-size: .94rem; font-weight: 800; color: #1c1917; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .ord-item-badges { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; margin-top: .38rem; }
    .ord-pill { display: inline-flex; align-items: center; gap: .3rem; border-radius: 999px; padding: .2rem .65rem; font-size: .75rem; font-weight: 600; white-space: nowrap; }
    .ord-pill--variant { background: #f5f5f4; color: #292524; border: 1px solid #e7e5e4; }
    .ord-pill--qty { background: #1c1917; color: #fff; }
    .ord-engrave-box { margin-top: .8rem; background: #fdfbf7; border: 1px solid #ede6d6; border-radius: .85rem; padding: .8rem .9rem; }
    .ord-engrave-title { font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: #854d0e; margin-bottom: .55rem; display: flex; align-items: center; gap: .35rem; }
    .ord-engrave-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: .6rem; }
    .ord-engrave-row { background: #fff; border: 1px solid #e7e5e4; border-radius: .7rem; padding: .6rem .75rem; }
    .ord-engrave-row-head { display: flex; align-items: center; justify-content: space-between; gap: .4rem; margin-bottom: .28rem; }
    .ord-engrave-label { font-size: .72rem; font-weight: 700; color: #57534e; text-transform: uppercase; letter-spacing: .03em; }
    .ord-engrave-surcharge { font-size: .71rem; font-weight: 700; color: #0f766e; background: #f0fdfa; border: 1px solid #ccfbf1; border-radius: 999px; padding: .1rem .45rem; white-space: nowrap; }
    .ord-engrave-text { font-size: .96rem; font-weight: 800; color: #1c1917; margin-bottom: .3rem; word-break: break-word; }
    .ord-engrave-font { display: inline-flex; align-items: center; gap: .3rem; font-size: .74rem; color: #44403c; background: #f5f5f4; border-radius: .45rem; padding: .16rem .48rem; }
    .ord-engrave-font strong { color: #1c1917; }
    .ord-side { background: #fafaf9; border: 1px solid #e7e5e4; border-radius: 1rem; padding: 1.1rem; }
    .ord-totals { margin-top: 1.1rem; padding-top: .85rem; border-top: 1px solid #e7e5e4; display: flex; flex-direction: column; gap: .42rem; font-size: .85rem; }
    .ord-total-row { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
    .ord-total-row strong { font-variant-numeric: tabular-nums; white-space: nowrap; color: #1c1917; }
    .ord-total-row--grand { font-size: .98rem; padding-top: .48rem; border-top: 1px solid #e7e5e4; margin-top: .15rem; }
    .ord-notes { margin-top: .95rem; padding-top: .85rem; border-top: 1px solid #e7e5e4; }
    .ord-notes-label { font-size: .74rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: #78716c; margin-bottom: .28rem; }
    .ord-notes-text { font-size: .84rem; color: #292524; white-space: pre-line; margin: 0; line-height: 1.45; }
    .ord-empty-box { background: #fff; border: 1px solid #e7e5e4; border-radius: 1rem; padding: 2.25rem 1rem; text-align: center; color: #78716c; font-size: .9rem; }
  </style>
</head>
<body class="admin-shell-body">
  <%- include("../../partials/admin-shell-start") %>
  <%
    const STATUS_LABELS = {
      pending: "Pendiente",
      confirmed: "Confirmado",
      processing: "Procesando",
      completed: "Completado",
      cancelled: "Cancelado"
    };
    const imgFallbackMap = typeof productImageMap === "object" && productImageMap ? productImageMap : {};
    const allOrders = Array.isArray(orders) ? orders : [];
    const statusCounts = { pending: 0, confirmed: 0, processing: 0, completed: 0, cancelled: 0 };
    allOrders.forEach(function (o) {
      const k = String(o.status || "pending").toLowerCase();
      if (statusCounts[k] !== undefined) statusCounts[k] += 1;
    });
    function formatOrderDate(dt) {
      if (!dt) return "";
      const d = new Date(dt);
      if (Number.isNaN(d.getTime())) return "";
      return d.toLocaleString("es-DO", {
        timeZone: "America/Santo_Domingo",
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit"
      });
    }
    function formatOrderIsoDay(dt) {
      if (!dt) return "";
      const d = new Date(dt);
      if (Number.isNaN(d.getTime())) return "";
      const parts = new Intl.DateTimeFormat("en-CA", {
        timeZone: "America/Santo_Domingo",
        year: "numeric",
        month: "2-digit",
        day: "2-digit"
      }).formatToParts(d);
      const y = parts.find((p) => p.type === "year")?.value;
      const m = parts.find((p) => p.type === "month")?.value;
      const day = parts.find((p) => p.type === "day")?.value;
      return y && m && day ? `${y}-${m}-${day}` : "";
    }
    function formatMoney(val) {
      return "RD$ " + Number(val || 0).toLocaleString("es-DO", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
  %>
  <main class="ord-page">
    <% if (typeof saved !== "undefined" && saved) { %>
      <div role="status" class="rounded-2xl bg-green-50 border border-green-200 text-green-800 px-4 py-3 text-sm font-medium">
        Estado del pedido actualizado correctamente.
      </div>
    <% } %>

    <section class="ord-toolbar-card" aria-label="Filtros de pedidos">
      <div class="ord-toolbar-row">
        <div class="ord-filter-field ord-search-wrap">
          <label for="ordSearchInput">Buscar pedido</label>
          <input id="ordSearchInput" type="search" class="ord-filter-input" placeholder="Código, cliente, teléfono o producto...">
        </div>
        <div class="ord-filter-field">
          <label for="ordDateFrom">Fecha desde</label>
          <input id="ordDateFrom" type="date" class="ord-filter-input">
        </div>
        <div class="ord-filter-field">
          <label for="ordDateTo">Fecha hasta</label>
          <input id="ordDateTo" type="date" class="ord-filter-input">
        </div>
        <div class="ord-filter-field">
          <label for="ordStatusSelect">Estado</label>
          <select id="ordStatusSelect" class="ord-filter-select">
            <option value="all">Todos (<%= allOrders.length %>)</option>
            <option value="pending">Pendiente (<%= statusCounts.pending %>)</option>
            <option value="confirmed">Confirmado (<%= statusCounts.confirmed %>)</option>
            <option value="processing">Procesando (<%= statusCounts.processing %>)</option>
            <option value="completed">Completado (<%= statusCounts.completed %>)</option>
            <option value="cancelled">Cancelado (<%= statusCounts.cancelled %>)</option>
          </select>
        </div>
      </div>

      <div class="ord-status-pills" role="group" aria-label="Filtro rápido por estado">
        <button type="button" class="ord-pill-btn is-active" data-status-pill="all">Todos (<%= allOrders.length %>)</button>
        <button type="button" class="ord-pill-btn" data-status-pill="pending">Pendiente (<%= statusCounts.pending %>)</button>
        <button type="button" class="ord-pill-btn" data-status-pill="confirmed">Confirmado (<%= statusCounts.confirmed %>)</button>
        <button type="button" class="ord-pill-btn" data-status-pill="processing">Procesando (<%= statusCounts.processing %>)</button>
        <button type="button" class="ord-pill-btn" data-status-pill="completed">Completado (<%= statusCounts.completed %>)</button>
        <button type="button" class="ord-pill-btn" data-status-pill="cancelled">Cancelado (<%= statusCounts.cancelled %>)</button>
      </div>

      <div class="ord-toolbar-meta">
        <div>Mostrando <strong id="ordVisibleCount"><%= allOrders.length %></strong> de <strong><%= allOrders.length %></strong> pedidos · Haz clic en un pedido para ver el detalle completo.</div>
        <div class="ord-meta-actions">
          <button type="button" class="ord-mini-btn" id="ordQuickToday">Hoy</button>
          <button type="button" class="ord-mini-btn" id="ordQuick7d">Últimos 7 días</button>
          <button type="button" class="ord-mini-btn" id="ordClearFilters">Limpiar filtros</button>
          <button type="button" class="ord-mini-btn" id="ordToggleAll">Expandir todos</button>
        </div>
      </div>
    </section>

    <% if (!allOrders.length) { %>
      <div class="ord-empty-box">No hay pedidos registrados.</div>
    <% } else { %>
      <div class="ord-list" id="ordList">
        <% allOrders.forEach(function(order) { %>
          <%
            const st = String(order.status || "pending").toLowerCase();
            const stLabel = STATUS_LABELS[st] || st;
            const orderDateStr = formatOrderDate(order.createdAt);
            const orderIsoDay = formatOrderIsoDay(order.createdAt);
            const shortId = String(order._id || "").slice(-8).toUpperCase();
            const items = Array.isArray(order.items) ? order.items : [];
            const firstItem = items[0] || {};
            const firstRawImg = firstItem.imageUrl || imgFallbackMap[String(firstItem.productId || "")] || "";
            const firstThumb = firstRawImg ? safePublicUrl(firstRawImg) : "";
            const firstVariant = firstItem.variantLabel || firstItem.variantOptionValue || "";
            const searchBlob = [
              shortId,
              order._id,
              order.customerName,
              order.phone,
              order.email,
              items.map((i) => [i.productName, i.variantLabel, i.variantOptionValue].join(" ")).join(" ")
            ].join(" ").toLowerCase();
          %>
          <details class="ord-card" data-order-card data-status="<%= st %>" data-day="<%= orderIsoDay %>" data-search="<%= searchBlob %>">
            <summary class="ord-summary">
              <% if (firstThumb) { %>
                <img src="<%= firstThumb %>" alt="<%= firstItem.productName || 'Producto' %>" class="ord-sum-thumb" loading="lazy">
              <% } else { %>
                <div class="ord-sum-thumb-empty" aria-hidden="true">Sin foto</div>
              <% } %>

              <div>
                <div class="ord-sum-id">#<%= shortId %></div>
                <div class="ord-sum-date"><%= orderDateStr || "Sin fecha" %></div>
              </div>

              <div>
                <div class="ord-sum-customer"><%= order.customerName %></div>
                <div class="ord-sum-phone"><%= order.phone %></div>
              </div>

              <div class="ord-sum-prod">
                <%= firstItem.productName || "Pedido sin artículos" %><% if (items.length > 1) { %> (+<%= items.length - 1 %> más)<% } %>
                <small><%= firstVariant ? ("Variante: " + firstVariant) : ("Cant: " + (firstItem.quantity || 1)) %><%= firstItem.engravingFields && firstItem.engravingFields.length ? " · Personalizado" : "" %></small>
              </div>

              <span class="ord-status ord-status--<%= st %>"><%= stLabel %></span>

              <div class="ord-sum-total"><%= formatMoney(order.total) %></div>

              <span class="ord-chevron" aria-hidden="true">▾</span>
            </summary>

            <div class="ord-detail">
              <div class="ord-grid">
                <div>
                  <div class="ord-head">
                    <div class="ord-id-wrap">
                      <h3 class="ord-title">Pedido #<%= shortId %></h3>
                      <span class="ord-status ord-status--<%= st %>"><%= stLabel %></span>
                    </div>
                    <div class="ord-date">
                      <% if (orderDateStr) { %><%= orderDateStr %> · <% } %>ID: <%= order._id %>
                    </div>
                  </div>

                  <div class="ord-customer-grid">
                    <div class="ord-customer-item"><span>Cliente</span><strong><%= order.customerName %></strong></div>
                    <div class="ord-customer-item"><span>Teléfono</span><strong><%= order.phone %></strong></div>
                    <div class="ord-customer-item"><span>Correo</span><strong><%= order.email || "No indicado" %></strong></div>
                    <div class="ord-customer-item"><span>Método de envío</span><strong><%= order.shippingMethod %></strong></div>
                  </div>

                  <div class="ord-items-list">
                    <% items.forEach(function(item) { %>
                      <%
                        const rawImg = item.imageUrl || imgFallbackMap[String(item.productId || "")] || "";
                        const itemImg = rawImg ? safePublicUrl(rawImg) : "";
                        const variantText = item.variantLabel || item.variantOptionValue || "";
                        const structuredFields = Array.isArray(item.engravingFields) && item.engravingFields.length ? item.engravingFields : [];
                        const legacyParts = !structuredFields.length && item.customizationSummary
                          ? String(item.customizationSummary).split("|").map((p) => p.trim()).filter(Boolean)
                          : [];
                        const lineAmount = Number(item.lineTotal || (Number(item.unitPrice || 0) * Number(item.quantity || 1)));
                      %>
                      <div class="ord-item-card">
                        <div class="ord-item-top">
                          <% if (itemImg) { %>
                            <img src="<%= itemImg %>" alt="<%= item.productName %>" class="ord-thumb" loading="lazy">
                          <% } else { %>
                            <div class="ord-thumb-empty" aria-hidden="true">Sin foto</div>
                          <% } %>

                          <div class="ord-item-info">
                            <div class="ord-item-header">
                              <h4 class="ord-item-name"><%= item.productName %></h4>
                              <% if (lineAmount > 0) { %>
                                <span class="ord-item-price"><%= formatMoney(lineAmount) %></span>
                              <% } %>
                            </div>
                            <div class="ord-item-badges">
                              <span class="ord-pill ord-pill--qty">Cantidad: <%= item.quantity %></span>
                              <% if (variantText) { %>
                                <span class="ord-pill ord-pill--variant">Variante: <%= variantText %></span>
                              <% } %>
                            </div>
                          </div>
                        </div>

                        <% if (structuredFields.length) { %>
                          <div class="ord-engrave-box">
                            <div class="ord-engrave-title">✎ Detalle de personalización / grabado</div>
                            <div class="ord-engrave-list">
                              <% structuredFields.forEach(function(field) { %>
                                <%
                                  const extraMinor = Number(field.priceDeltaMinor || 0);
                                  const fontLabel = field.fontName || item.fontName || "";
                                %>
                                <div class="ord-engrave-row">
                                  <div class="ord-engrave-row-head">
                                    <span class="ord-engrave-label"><%= field.label || field.key || "Grabado" %></span>
                                    <% if (extraMinor > 0) { %>
                                      <span class="ord-engrave-surcharge">+<%= formatMoney(extraMinor / 100) %></span>
                                    <% } else { %>
                                      <span class="ord-engrave-surcharge">Incluido</span>
                                    <% } %>
                                  </div>
                                  <div class="ord-engrave-text">“<%= field.value %>”</div>
                                  <% if (fontLabel) { %>
                                    <div class="ord-engrave-font">Tipografía: <strong><%= fontLabel %></strong></div>
                                  <% } %>
                                </div>
                              <% }) %>
                            </div>
                          </div>
                        <% } else if (legacyParts.length) { %>
                          <div class="ord-engrave-box">
                            <div class="ord-engrave-title">✎ Detalle de personalización</div>
                            <div class="ord-engrave-list">
                              <% legacyParts.forEach(function(part) { %>
                                <div class="ord-engrave-row">
                                  <div class="ord-engrave-text" style="font-size:.86rem;margin-bottom:0;"><%= part %></div>
                                </div>
                              <% }) %>
                            </div>
                          </div>
                        <% } %>

                        <%
                          const orderPhotos = Array.isArray(item.customizationPhotoUrls) && item.customizationPhotoUrls.length
                            ? item.customizationPhotoUrls
                            : (item.customizationPhotoUrl ? [item.customizationPhotoUrl] : []);
                        %>
                        <% if (orderPhotos.length) { %>
                          <div class="mt-3 rounded-xl border border-stone-200 bg-stone-50 p-3">
                            <div class="text-sm font-medium text-stone-700 mb-2">Fotos para fotograbado (<%= orderPhotos.length %>)</div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                              <% orderPhotos.forEach(function(photoUrl, photoIdx) { %>
                                <div class="rounded-xl border border-stone-200 bg-white p-2 flex flex-col gap-2">
                                  <img src="<%= photoUrl %>" alt="Foto <%= photoIdx + 1 %> para fotograbado" class="max-h-36 w-full rounded-lg object-contain bg-stone-50">
                                  <a href="<%= photoUrl %>" target="_blank" rel="noopener" class="inline-flex justify-center rounded-lg bg-[#016B83] text-white px-3 py-1.5 text-xs font-medium hover:opacity-90">Ver / descargar foto <%= photoIdx + 1 %></a>
                                </div>
                              <% }) %>
                            </div>
                          </div>
                        <% } %>
                      </div>
                    <% }) %>
                  </div>
                </div>

                <aside class="ord-side">
                  <h4 class="text-base font-bold text-stone-900 mb-3">Acciones</h4>

                  <%
                    const customerWhatsappDigits = String(order.phone || '').replace(/[^0-9]/g, '');
                    const customerWhatsappText = encodeURIComponent('Hola ' + (order.customerName || '') + ', te escribimos de GATON DO sobre tu pedido ' + order._id + '.');
                  %>
                  <% if (customerWhatsappDigits) { %>
                    <a href="https://wa.me/<%= customerWhatsappDigits %>?text=<%= customerWhatsappText %>" target="_blank" rel="noopener" class="block w-full text-center rounded-xl bg-[#016B83] text-white px-4 py-3 text-sm font-medium hover:opacity-90 mb-4">
                      Escribir al cliente
                    </a>
                  <% } %>

                  <form action="/admin/orders/<%= order._id %>/status" method="post" class="space-y-3">
                    <input type="hidden" name="_csrf" value="<%= adminCsrfToken %>">
                    <div>
                      <label class="block text-xs font-semibold uppercase tracking-wide text-stone-600 mb-1.5">Estado del pedido</label>
                      <select name="status" class="w-full rounded-xl border border-stone-300 bg-white px-3 py-2.5 text-sm">
                        <option value="pending" <%= st === "pending" ? "selected" : "" %>>Pendiente</option>
                        <option value="confirmed" <%= st === "confirmed" ? "selected" : "" %>>Confirmado</option>
                        <option value="processing" <%= st === "processing" ? "selected" : "" %>>Procesando</option>
                        <option value="completed" <%= st === "completed" ? "selected" : "" %>>Completado</option>
                        <option value="cancelled" <%= st === "cancelled" ? "selected" : "" %>>Cancelado</option>
                      </select>
                    </div>

                    <button type="submit" class="w-full rounded-xl bg-stone-900 text-white px-4 py-2.5 text-sm font-medium hover:bg-stone-800">
                      Guardar estado
                    </button>
                  </form>

                  <div class="ord-totals">
                    <div class="ord-total-row">
                      <span class="text-stone-500">Subtotal</span>
                      <strong><%= formatMoney(order.subtotal) %></strong>
                    </div>
                    <div class="ord-total-row">
                      <span class="text-stone-500">Envío</span>
                      <strong><%= formatMoney(order.shippingCost) %></strong>
                    </div>
                    <div class="ord-total-row ord-total-row--grand">
                      <span class="font-bold text-stone-900">Total</span>
                      <strong><%= formatMoney(order.total) %></strong>
                    </div>
                  </div>

                  <% if (order.notes) { %>
                    <div class="ord-notes">
                      <div class="ord-notes-label">Notas / Dirección</div>
                      <p class="ord-notes-text"><%= order.notes %></p>
                    </div>
                  <% } %>
                </aside>
              </div>
            </div>
          </details>
        <% }) %>
      </div>
      <div id="ordEmptyFilter" class="ord-empty-box" hidden>No hay pedidos que coincidan con los filtros seleccionados.</div>
    <% } %>
  </main>

  <script>
    (function () {
      const cards = Array.from(document.querySelectorAll("[data-order-card]"));
      const searchInput = document.getElementById("ordSearchInput");
      const dateFromInput = document.getElementById("ordDateFrom");
      const dateToInput = document.getElementById("ordDateTo");
      const statusSelect = document.getElementById("ordStatusSelect");
      const statusPills = Array.from(document.querySelectorAll("[data-status-pill]"));
      const visibleCountEl = document.getElementById("ordVisibleCount");
      const emptyFilterEl = document.getElementById("ordEmptyFilter");
      const toggleAllBtn = document.getElementById("ordToggleAll");

      function santoDomingoIso(offsetDays) {
        const d = new Date(Date.now() + (offsetDays || 0) * 86400000);
        const parts = new Intl.DateTimeFormat("en-CA", {
          timeZone: "America/Santo_Domingo",
          year: "numeric",
          month: "2-digit",
          day: "2-digit"
        }).formatToParts(d);
        const y = parts.find(function (p) { return p.type === "year"; })?.value;
        const m = parts.find(function (p) { return p.type === "month"; })?.value;
        const day = parts.find(function (p) { return p.type === "day"; })?.value;
        return y && m && day ? (y + "-" + m + "-" + day) : "";
      }

      function syncStatusUI(val) {
        if (statusSelect) statusSelect.value = val;
        statusPills.forEach(function (btn) {
          btn.classList.toggle("is-active", btn.dataset.statusPill === val);
        });
      }

      function applyFilters() {
        const q = (searchInput?.value || "").trim().toLowerCase();
        const st = statusSelect?.value || "all";
        const from = dateFromInput?.value || "";
        const to = dateToInput?.value || "";
        let visible = 0;

        cards.forEach(function (card) {
          const day = card.dataset.day || "";
          const okStatus = st === "all" || card.dataset.status === st;
          const okSearch = !q || (card.dataset.search || "").includes(q);
          const okFrom = !from || (day && day >= from);
          const okTo = !to || (day && day <= to);
          const show = okStatus && okSearch && okFrom && okTo;
          card.hidden = !show;
          if (show) visible += 1;
        });

        if (visibleCountEl) visibleCountEl.textContent = String(visible);
        if (emptyFilterEl) emptyFilterEl.hidden = visible > 0 || cards.length === 0;
      }

      if (searchInput) searchInput.addEventListener("input", applyFilters);
      if (dateFromInput) dateFromInput.addEventListener("change", applyFilters);
      if (dateToInput) dateToInput.addEventListener("change", applyFilters);
      if (statusSelect) {
        statusSelect.addEventListener("change", function () {
          syncStatusUI(statusSelect.value);
          applyFilters();
        });
      }
      statusPills.forEach(function (btn) {
        btn.addEventListener("click", function () {
          syncStatusUI(btn.dataset.statusPill || "all");
          applyFilters();
        });
      });

      const quickToday = document.getElementById("ordQuickToday");
      if (quickToday) {
        quickToday.addEventListener("click", function () {
          const today = santoDomingoIso(0);
          if (dateFromInput) dateFromInput.value = today;
          if (dateToInput) dateToInput.value = today;
          applyFilters();
        });
      }

      const quick7d = document.getElementById("ordQuick7d");
      if (quick7d) {
        quick7d.addEventListener("click", function () {
          if (dateFromInput) dateFromInput.value = santoDomingoIso(-6);
          if (dateToInput) dateToInput.value = santoDomingoIso(0);
          applyFilters();
        });
      }

      const clearBtn = document.getElementById("ordClearFilters");
      if (clearBtn) {
        clearBtn.addEventListener("click", function () {
          if (searchInput) searchInput.value = "";
          if (dateFromInput) dateFromInput.value = "";
          if (dateToInput) dateToInput.value = "";
          syncStatusUI("all");
          applyFilters();
        });
      }

      if (toggleAllBtn) {
        toggleAllBtn.addEventListener("click", function () {
          const visibleCards = cards.filter(function (c) { return !c.hidden; });
          const anyClosed = visibleCards.some(function (c) { return !c.open; });
          visibleCards.forEach(function (c) { c.open = anyClosed; });
          toggleAllBtn.textContent = anyClosed ? "Contraer todos" : "Expandir todos";
        });
      }
    })();
  </script>
  <%- include("../../partials/admin-shell-end") %>
</body>
</html>
