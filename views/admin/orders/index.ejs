<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pedidos | Admin</title>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/admin-utilities.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-shell-body">
  <%- include("../../partials/admin-shell-start") %>
<main class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between gap-4 mb-8">
      <div>
        <h2 class="text-3xl font-semibold text-stone-900">Pedidos</h2>
        <p class="text-stone-600 mt-2">Administra los pedidos recibidos desde el checkout.</p>
      </div>

      <a href="/admin/dashboard" class="rounded-xl bg-white border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-50">
        Volver
      </a>
    </div>

    <div class="space-y-5">
      <% if (!orders || orders.length === 0) { %>
        <div class="bg-white border border-stone-200 rounded-2xl p-8 text-center text-stone-500 shadow-sm">
          No hay pedidos registrados.
        </div>
      <% } %>

      <% if (orders && orders.length > 0) { %>
        <% orders.forEach(function(order) { %>
          <div class="bg-white border border-stone-200 rounded-2xl p-6 shadow-sm">
            <div class="grid grid-cols-1 lg:grid-cols-[1fr,280px] gap-6">
              <div>
                <div class="flex flex-wrap gap-3 items-center mb-4">
                  <h3 class="text-xl font-semibold text-stone-900">Pedido: <%= order._id %></h3>
                  <span class="inline-flex rounded-full bg-stone-100 text-stone-700 px-3 py-1 text-xs font-medium capitalize">
                    <%= order.status %>
                  </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm mb-5">
                  <div><span class="text-stone-500">Cliente:</span> <strong><%= order.customerName %></strong></div>
                  <div><span class="text-stone-500">Teléfono:</span> <strong><%= order.phone %></strong></div>
                  <div><span class="text-stone-500">Correo:</span> <strong><%= order.email || "No indicado" %></strong></div>
                  <div><span class="text-stone-500">Envío:</span> <strong><%= order.shippingMethod %></strong></div>
                </div>

                <div class="space-y-3">
                  <% (order.items || []).forEach(function(item) { %>
                    <div class="border border-stone-200 rounded-xl p-4">
                      <div class="font-medium text-stone-900"><%= item.productName %></div>
                      <div class="text-sm text-stone-500 mt-1">Cantidad: <%= item.quantity %></div>
                      <% if (item.variantLabel || item.variantOptionValue) { %>
                        <div class="text-sm text-stone-500 mt-1">
                          Variante: <%= item.variantLabel || item.variantOptionValue %>
                        </div>
                      <% } %>
                      <% if (item.customizationSummary) { %>
                        <div class="text-sm text-stone-500 mt-1">
                          Personalización: <%= item.customizationSummary %>
                        </div>
                      <% } %>
                      <% if (item.customizationPhotoUrl) { %>
                        <div class="mt-3 rounded-xl border border-stone-200 bg-stone-50 p-3">
                          <div class="text-sm font-medium text-stone-700 mb-2">Foto para fotograbado</div>
                          <a href="<%= item.customizationPhotoUrl %>" target="_blank" rel="noopener" class="inline-flex rounded-xl bg-[#016B83] text-white px-4 py-2 text-xs font-medium hover:opacity-90">Ver / descargar imagen</a>
                          <img src="<%= item.customizationPhotoUrl %>" alt="Foto para fotograbado" class="mt-3 max-h-36 rounded-xl border border-stone-200 object-contain bg-white">
                        </div>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
              </div>

              <div>
                <div class="bg-stone-50 rounded-2xl p-5">
                  <h4 class="text-lg font-semibold mb-4">Acciones</h4>


                  <%
                    const customerWhatsappDigits = String(order.phone || '').replace(/[^0-9]/g, '');
                    const customerWhatsappText = encodeURIComponent('Hola ' + (order.customerName || '') + ', te escribimos de GATON DO sobre tu pedido ' + order._id + '.');
                  %>
                  <% if (customerWhatsappDigits) { %>
                    <a href="https://wa.me/<%= customerWhatsappDigits %>?text=<%= customerWhatsappText %>" target="_blank" rel="noopener" class="block w-full text-center rounded-xl bg-[#016B83] text-white px-4 py-3 text-sm font-medium hover:opacity-90 mb-4">
                      Escribir al cliente
                    </a>
                  <% } %>

                  <form action="/admin/orders/<%= order._id %>/status" method="post" class="space-y-4">
                    <div>
                      <label class="block text-sm font-medium text-stone-700 mb-2">Estado</label>
                      <select name="status" class="w-full rounded-xl border border-stone-300 px-4 py-3">
                        <option value="pending" <%= order.status === "pending" ? "selected" : "" %>>Pendiente</option>
                        <option value="confirmed" <%= order.status === "confirmed" ? "selected" : "" %>>Confirmado</option>
                        <option value="processing" <%= order.status === "processing" ? "selected" : "" %>>Procesando</option>
                        <option value="completed" <%= order.status === "completed" ? "selected" : "" %>>Completado</option>
                        <option value="cancelled" <%= order.status === "cancelled" ? "selected" : "" %>>Cancelado</option>
                      </select>
                    </div>

                    <button type="submit" class="w-full rounded-xl bg-stone-900 text-white px-4 py-3 text-sm font-medium hover:bg-stone-800">
                      Guardar estado
                    </button>
                  </form>

                  <div class="mt-6 pt-4 border-t border-stone-200 space-y-2 text-sm">
                    <div class="flex items-center justify-between">
                      <span class="text-stone-500">Subtotal</span>
                      <strong>RD$ <%= Number(order.subtotal || 0).toFixed(2) %></strong>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-stone-500">Envío</span>
                      <strong>RD$ <%= Number(order.shippingCost || 0).toFixed(2) %></strong>
                    </div>
                    <div class="flex items-center justify-between text-base pt-2 border-t border-stone-200">
                      <span class="font-semibold">Total</span>
                      <strong>RD$ <%= Number(order.total || 0).toFixed(2) %></strong>
                    </div>
                  </div>

                  <% if (order.notes) { %>
                    <div class="mt-6 pt-4 border-t border-stone-200">
                      <div class="text-sm font-medium text-stone-700 mb-2">Notas</div>
                      <p class="text-sm text-stone-600 whitespace-pre-line"><%= order.notes %></p>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </main>
  <%- include("../../partials/admin-shell-end") %>
</body>
</html>