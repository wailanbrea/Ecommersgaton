<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pedidos | Admin</title>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/admin-utilities.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .ord-page { max-width: 1280px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; display: flex; flex-direction: column; gap: 1.25rem; }
    .ord-top-bar { display: flex; justify-content: flex-end; gap: .75rem; }
    .ord-card { background: #fff; border: 1px solid #e7e5e4; border-radius: 1.25rem; padding: 1.4rem 1.5rem; box-shadow: 0 1px 3px rgba(28,25,23,.05); }
    .ord-grid { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: 1.5rem; align-items: start; }
    @media (max-width: 980px) { .ord-grid { grid-template-columns: 1fr; } }
    .ord-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; padding-bottom: 1rem; border-bottom: 1px solid #f5f5f4; margin-bottom: 1rem; }
    .ord-id-wrap { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
    .ord-title { font-size: 1.15rem; font-weight: 800; color: #1c1917; margin: 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
    .ord-date { font-size: .8rem; color: #78716c; }
    .ord-status { display: inline-flex; align-items: center; border-radius: 999px; padding: .26rem .72rem; font-size: .75rem; font-weight: 700; white-space: nowrap; }
    .ord-status--pending { background: #fef3c7; color: #92400e; }
    .ord-status--confirmed { background: #dbeafe; color: #1e40af; }
    .ord-status--processing { background: #ede9fe; color: #5b21b6; }
    .ord-status--completed { background: #dcfce7; color: #166534; }
    .ord-status--cancelled { background: #fee2e2; color: #991b1b; }
    .ord-customer-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem 1.25rem; background: #fafaf9; border: 1px solid #f0efed; border-radius: .9rem; padding: .85rem 1rem; margin-bottom: 1.15rem; font-size: .85rem; }
    @media (max-width: 640px) { .ord-customer-grid { grid-template-columns: 1fr; } }
    .ord-customer-item span { display: block; font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; color: #78716c; font-weight: 700; margin-bottom: .1rem; }
    .ord-customer-item strong { color: #1c1917; font-weight: 600; word-break: break-word; }
    .ord-items-list { display: flex; flex-direction: column; gap: .9rem; }
    .ord-item-card { border: 1px solid #e7e5e4; border-radius: 1rem; padding: 1rem; background: #fff; }
    .ord-item-top { display: flex; align-items: flex-start; gap: 1rem; }
    .ord-thumb { width: 76px; height: 76px; border-radius: .85rem; object-fit: cover; border: 1px solid #e7e5e4; background: #fafaf9; flex-shrink: 0; }
    .ord-thumb-empty { width: 76px; height: 76px; border-radius: .85rem; border: 1px dashed #d6d3d1; background: #fafaf9; color: #a8a29e; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: .72rem; font-weight: 600; text-align: center; }
    .ord-item-info { flex: 1; min-width: 0; }
    .ord-item-header { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: .5rem; }
    .ord-item-name { font-size: 1rem; font-weight: 700; color: #1c1917; margin: 0; }
    .ord-item-price { font-size: .95rem; font-weight: 800; color: #1c1917; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .ord-item-badges { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; margin-top: .4rem; }
    .ord-pill { display: inline-flex; align-items: center; gap: .3rem; border-radius: 999px; padding: .2rem .65rem; font-size: .76rem; font-weight: 600; white-space: nowrap; }
    .ord-pill--variant { background: #f5f5f4; color: #292524; border: 1px solid #e7e5e4; }
    .ord-pill--qty { background: #1c1917; color: #fff; }
    .ord-engrave-box { margin-top: .85rem; background: #fdfbf7; border: 1px solid #ede6d6; border-radius: .85rem; padding: .85rem .95rem; }
    .ord-engrave-title { font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: #854d0e; margin-bottom: .6rem; display: flex; align-items: center; gap: .35rem; }
    .ord-engrave-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: .65rem; }
    .ord-engrave-row { background: #fff; border: 1px solid #e7e5e4; border-radius: .7rem; padding: .65rem .75rem; }
    .ord-engrave-row-head { display: flex; align-items: center; justify-content: space-between; gap: .4rem; margin-bottom: .3rem; }
    .ord-engrave-label { font-size: .73rem; font-weight: 700; color: #57534e; text-transform: uppercase; letter-spacing: .03em; }
    .ord-engrave-surcharge { font-size: .72rem; font-weight: 700; color: #0f766e; background: #f0fdfa; border: 1px solid #ccfbf1; border-radius: 999px; padding: .1rem .45rem; white-space: nowrap; }
    .ord-engrave-text { font-size: .98rem; font-weight: 800; color: #1c1917; margin-bottom: .35rem; word-break: break-word; }
    .ord-engrave-font { display: inline-flex; align-items: center; gap: .3rem; font-size: .75rem; color: #44403c; background: #f5f5f4; border-radius: .45rem; padding: .18rem .5rem; }
    .ord-engrave-font strong { color: #1c1917; }
    .ord-side { background: #fafaf9; border: 1px solid #e7e5e4; border-radius: 1rem; padding: 1.15rem; }
    .ord-totals { margin-top: 1.15rem; padding-top: .9rem; border-top: 1px solid #e7e5e4; display: flex; flex-direction: column; gap: .45rem; font-size: .86rem; }
    .ord-total-row { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
    .ord-total-row strong { font-variant-numeric: tabular-nums; white-space: nowrap; color: #1c1917; }
    .ord-total-row--grand { font-size: 1rem; padding-top: .5rem; border-top: 1px solid #e7e5e4; margin-top: .15rem; }
    .ord-notes { margin-top: 1rem; padding-top: .9rem; border-top: 1px solid #e7e5e4; }
    .ord-notes-label { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: #78716c; margin-bottom: .3rem; }
    .ord-notes-text { font-size: .85rem; color: #292524; white-space: pre-line; margin: 0; line-height: 1.45; }
  </style>
</head>
<body class="admin-shell-body">
  <%- include("../../partials/admin-shell-start") %>
  <%
    const STATUS_LABELS = {
      pending: "Pendiente",
      confirmed: "Confirmado",
      processing: "Procesando",
      completed: "Completado",
      cancelled: "Cancelado"
    };
    const imgFallbackMap = typeof productImageMap === "object" && productImageMap ? productImageMap : {};
    function formatOrderDate(dt) {
      if (!dt) return "";
      const d = new Date(dt);
      if (Number.isNaN(d.getTime())) return "";
      return d.toLocaleString("es-DO", {
        timeZone: "America/Santo_Domingo",
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit"
      });
    }
    function formatMoney(val) {
      return "RD$ " + Number(val || 0).toLocaleString("es-DO", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
  %>
  <main class="ord-page">
    <% if (typeof saved !== "undefined" && saved) { %>
      <div role="status" class="rounded-2xl bg-green-50 border border-green-200 text-green-800 px-4 py-3 text-sm font-medium">
        Estado del pedido actualizado correctamente.
      </div>
    <% } %>

    <div class="ord-top-bar">
      <a href="/admin/dashboard" class="rounded-xl bg-white border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-50">
        Volver
      </a>
    </div>

    <% if (!orders || orders.length === 0) { %>
      <div class="ord-card text-center text-stone-500">
        No hay pedidos registrados.
      </div>
    <% } %>

    <% if (orders && orders.length > 0) { %>
      <% orders.forEach(function(order) { %>
        <%
          const st = String(order.status || "pending").toLowerCase();
          const stLabel = STATUS_LABELS[st] || st;
          const orderDateStr = formatOrderDate(order.createdAt);
        %>
        <article class="ord-card">
          <div class="ord-grid">
            <div>
              <div class="ord-head">
                <div class="ord-id-wrap">
                  <h3 class="ord-title">Pedido #<%= String(order._id || "").slice(-8).toUpperCase() %></h3>
                  <span class="ord-status ord-status--<%= st %>"><%= stLabel %></span>
                </div>
                <div class="ord-date">
                  <% if (orderDateStr) { %><%= orderDateStr %> · <% } %>ID: <%= order._id %>
                </div>
              </div>

              <div class="ord-customer-grid">
                <div class="ord-customer-item"><span>Cliente</span><strong><%= order.customerName %></strong></div>
                <div class="ord-customer-item"><span>Teléfono</span><strong><%= order.phone %></strong></div>
                <div class="ord-customer-item"><span>Correo</span><strong><%= order.email || "No indicado" %></strong></div>
                <div class="ord-customer-item"><span>Método de envío</span><strong><%= order.shippingMethod %></strong></div>
              </div>

              <div class="ord-items-list">
                <% (order.items || []).forEach(function(item) { %>
                  <%
                    const rawImg = item.imageUrl || imgFallbackMap[String(item.productId || "")] || "";
                    const itemImg = rawImg ? safePublicUrl(rawImg) : "";
                    const variantText = item.variantLabel || item.variantOptionValue || "";
                    const structuredFields = Array.isArray(item.engravingFields) && item.engravingFields.length ? item.engravingFields : [];
                    const legacyParts = !structuredFields.length && item.customizationSummary
                      ? String(item.customizationSummary).split("|").map((p) => p.trim()).filter(Boolean)
                      : [];
                    const lineAmount = Number(item.lineTotal || (Number(item.unitPrice || 0) * Number(item.quantity || 1)));
                  %>
                  <div class="ord-item-card">
                    <div class="ord-item-top">
                      <% if (itemImg) { %>
                        <img src="<%= itemImg %>" alt="<%= item.productName %>" class="ord-thumb" loading="lazy">
                      <% } else { %>
                        <div class="ord-thumb-empty" aria-hidden="true">Sin foto</div>
                      <% } %>

                      <div class="ord-item-info">
                        <div class="ord-item-header">
                          <h4 class="ord-item-name"><%= item.productName %></h4>
                          <% if (lineAmount > 0) { %>
                            <span class="ord-item-price"><%= formatMoney(lineAmount) %></span>
                          <% } %>
                        </div>
                        <div class="ord-item-badges">
                          <span class="ord-pill ord-pill--qty">Cantidad: <%= item.quantity %></span>
                          <% if (variantText) { %>
                            <span class="ord-pill ord-pill--variant">Variante: <%= variantText %></span>
                          <% } %>
                        </div>
                      </div>
                    </div>

                    <% if (structuredFields.length) { %>
                      <div class="ord-engrave-box">
                        <div class="ord-engrave-title">✎ Detalle de personalización / grabado</div>
                        <div class="ord-engrave-list">
                          <% structuredFields.forEach(function(field) { %>
                            <%
                              const extraMinor = Number(field.priceDeltaMinor || 0);
                              const fontLabel = field.fontName || item.fontName || "";
                            %>
                            <div class="ord-engrave-row">
                              <div class="ord-engrave-row-head">
                                <span class="ord-engrave-label"><%= field.label || field.key || "Grabado" %></span>
                                <% if (extraMinor > 0) { %>
                                  <span class="ord-engrave-surcharge">+<%= formatMoney(extraMinor / 100) %></span>
                                <% } else { %>
                                  <span class="ord-engrave-surcharge">Incluido</span>
                                <% } %>
                              </div>
                              <div class="ord-engrave-text">“<%= field.value %>”</div>
                              <% if (fontLabel) { %>
                                <div class="ord-engrave-font">Tipografía: <strong><%= fontLabel %></strong></div>
                              <% } %>
                            </div>
                          <% }) %>
                        </div>
                      </div>
                    <% } else if (legacyParts.length) { %>
                      <div class="ord-engrave-box">
                        <div class="ord-engrave-title">✎ Detalle de personalización</div>
                        <div class="ord-engrave-list">
                          <% legacyParts.forEach(function(part) { %>
                            <div class="ord-engrave-row">
                              <div class="ord-engrave-text" style="font-size:.86rem;margin-bottom:0;"><%= part %></div>
                            </div>
                          <% }) %>
                        </div>
                      </div>
                    <% } %>

                    <% if (item.customizationPhotoUrl) { %>
                      <div class="mt-3 rounded-xl border border-stone-200 bg-stone-50 p-3">
                        <div class="text-sm font-medium text-stone-700 mb-2">Foto para fotograbado</div>
                        <a href="<%= item.customizationPhotoUrl %>" target="_blank" rel="noopener" class="inline-flex rounded-xl bg-[#016B83] text-white px-4 py-2 text-xs font-medium hover:opacity-90">Ver / descargar imagen</a>
                        <img src="<%= item.customizationPhotoUrl %>" alt="Foto para fotograbado" class="mt-3 max-h-36 rounded-xl border border-stone-200 object-contain bg-white">
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>

            <aside class="ord-side">
              <h4 class="text-base font-bold text-stone-900 mb-3">Acciones</h4>

              <%
                const customerWhatsappDigits = String(order.phone || '').replace(/[^0-9]/g, '');
                const customerWhatsappText = encodeURIComponent('Hola ' + (order.customerName || '') + ', te escribimos de GATON DO sobre tu pedido ' + order._id + '.');
              %>
              <% if (customerWhatsappDigits) { %>
                <a href="https://wa.me/<%= customerWhatsappDigits %>?text=<%= customerWhatsappText %>" target="_blank" rel="noopener" class="block w-full text-center rounded-xl bg-[#016B83] text-white px-4 py-3 text-sm font-medium hover:opacity-90 mb-4">
                  Escribir al cliente
                </a>
              <% } %>

              <form action="/admin/orders/<%= order._id %>/status" method="post" class="space-y-3">
                <input type="hidden" name="_csrf" value="<%= adminCsrfToken %>">
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wide text-stone-600 mb-1.5">Estado del pedido</label>
                  <select name="status" class="w-full rounded-xl border border-stone-300 bg-white px-3 py-2.5 text-sm">
                    <option value="pending" <%= st === "pending" ? "selected" : "" %>>Pendiente</option>
                    <option value="confirmed" <%= st === "confirmed" ? "selected" : "" %>>Confirmado</option>
                    <option value="processing" <%= st === "processing" ? "selected" : "" %>>Procesando</option>
                    <option value="completed" <%= st === "completed" ? "selected" : "" %>>Completado</option>
                    <option value="cancelled" <%= st === "cancelled" ? "selected" : "" %>>Cancelado</option>
                  </select>
                </div>

                <button type="submit" class="w-full rounded-xl bg-stone-900 text-white px-4 py-2.5 text-sm font-medium hover:bg-stone-800">
                  Guardar estado
                </button>
              </form>

              <div class="ord-totals">
                <div class="ord-total-row">
                  <span class="text-stone-500">Subtotal</span>
                  <strong><%= formatMoney(order.subtotal) %></strong>
                </div>
                <div class="ord-total-row">
                  <span class="text-stone-500">Envío</span>
                  <strong><%= formatMoney(order.shippingCost) %></strong>
                </div>
                <div class="ord-total-row ord-total-row--grand">
                  <span class="font-bold text-stone-900">Total</span>
                  <strong><%= formatMoney(order.total) %></strong>
                </div>
              </div>

              <% if (order.notes) { %>
                <div class="ord-notes">
                  <div class="ord-notes-label">Notas / Dirección</div>
                  <p class="ord-notes-text"><%= order.notes %></p>
                </div>
              <% } %>
            </aside>
          </div>
        </article>
      <% }) %>
    <% } %>
  </main>
  <%- include("../../partials/admin-shell-end") %>
</body>
</html>
