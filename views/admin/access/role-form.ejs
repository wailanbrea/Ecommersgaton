<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= role ? 'Editar rol' : 'Crear rol' %> | GATÓN DO</title><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/admin-utilities.css"><link rel="stylesheet" href="/css/admin.css"></head><body class="admin-shell-body"><%- include("../../partials/admin-shell-start") %>
<main class="admin-tool-page admin-access-page"><header class="admin-tool-heading"><div><span class="admin-eyebrow">ACCESO Y SEGURIDAD</span><h2><%= role ? 'Editar rol' : 'Crear rol' %></h2><p>Selecciona los permisos mínimos necesarios para esta función.</p></div><a class="admin-tool-button secondary" href="/admin/roles">Volver a roles</a></header>
<% if (error) { %><div class="admin-alert error"><%= error %></div><% } %><form method="post" action="<%= role ? `/admin/roles/${role.id}/edit` : '/admin/roles/new' %>" class="admin-tool-card admin-access-form"><input type="hidden" name="_csrf" value="<%= adminCsrfToken %>"><label>Nombre del rol<input name="name" maxlength="120" required value="<%= role?.name || '' %>" <%= role?.is_system ? 'readonly' : '' %>></label><label>Descripción<textarea name="description" maxlength="500" rows="3" <%= role?.is_system ? 'readonly' : '' %>><%= role?.description || '' %></textarea></label><fieldset><legend>Permisos</legend><% const areas=[...new Set(permissions.map((p)=>p.area))]; areas.forEach((area)=>{ %><section class="admin-permission-area"><h3><%= area %></h3><div class="admin-permission-grid"><% permissions.filter((p)=>p.area===area).forEach((permission)=>{ %><label class="admin-permission-choice"><input type="checkbox" name="permissions" value="<%= permission.id %>" <%= selected.includes(permission.id) ? 'checked' : '' %> <%= role?.is_system ? 'disabled' : '' %>><span><strong><%= permission.label %></strong><small><%= permission.code %></small></span></label><% }) %></div></section><% }) %></fieldset><div class="admin-tool-actions"><% if (!role?.is_system) { %><button class="admin-tool-button primary" type="submit">Guardar rol</button><% } %><a class="admin-tool-button secondary" href="/admin/roles">Cancelar</a></div></form></main><%- include("../../partials/admin-shell-end") %></body></html>
