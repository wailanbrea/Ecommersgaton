<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Roles y permisos | GATÓN DO</title><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/admin-utilities.css"><link rel="stylesheet" href="/css/admin.css"></head><body class="admin-shell-body"><%- include("../../partials/admin-shell-start") %>
<main class="admin-tool-page admin-access-page"><header class="admin-tool-heading"><a class="admin-tool-button primary" href="/admin/roles/new">Crear rol</a></header>
<% if (error) { %><div class="admin-alert error"><%= error %></div><% } %><% if (message) { %><div class="admin-alert success"><%= message %></div><% } %>
<section class="admin-access-role-list"><% roles.forEach((role) => { const codes=rolePermissionMap.get(role.id)||[]; %><article class="admin-tool-card admin-access-role"><header><div><span class="admin-eyebrow"><%= role.is_system ? 'ROL PROTEGIDO' : 'ROL PERSONALIZABLE' %></span><h3><%= role.name %></h3><p><%= role.description || 'Sin descripción.' %></p></div><span class="admin-status-pill"><%= userCounts.get(role.id)||0 %> usuarios</span></header><div class="admin-role-permissions"><% permissions.filter((p)=>codes.includes(p.code)).forEach((p)=>{ %><span><%= p.label %></span><% }) %></div><footer><span><%= codes.length %> permisos</span><div><% if (!role.is_system) { %><a class="admin-tool-button" href="/admin/roles/<%= role.id %>/edit">Editar permisos</a><% if (!(userCounts.get(role.id)||0)) { %><form method="post" action="/admin/roles/<%= role.id %>/delete" onsubmit="return confirm('¿Eliminar este rol?');"><input type="hidden" name="_csrf" value="<%= adminCsrfToken %>"><button class="admin-tool-button danger" type="submit">Eliminar</button></form><% } %><% } else { %><span class="admin-muted">Mantiene el acceso existente del propietario</span><% } %></div></footer></article><% }) %></section>
</main><%- include("../../partials/admin-shell-end") %></body></html>
