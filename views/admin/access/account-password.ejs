<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cambiar mi contraseña | GATÓN DO</title><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/admin-utilities.css"><link rel="stylesheet" href="/css/admin.css"></head><body class="admin-shell-body"><%- include("../../partials/admin-shell-start") %>
<main class="admin-tool-page admin-access-page"><% if (!required) { %><header class="admin-tool-heading"><a class="admin-tool-button secondary" href="/admin/dashboard">Volver al dashboard</a></header><% } %>
<% if (required) { %><div class="admin-alert warning">Esta cuenta debe establecer una contraseña propia antes de continuar usando el panel.</div><% } %><% if (error) { %><div class="admin-alert error"><%= error %></div><% } %><form class="admin-tool-card admin-access-form" method="post" action="/admin/account/password"><input type="hidden" name="_csrf" value="<%= adminCsrfToken %>"><% if (!required) { %><label>Contraseña actual<input name="currentPassword" type="password" autocomplete="current-password" required></label><% } %><label>Nueva contraseña<input name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required><small>Usa al menos 12 caracteres. No reutilices una contraseña compartida.</small></label><label>Confirmar nueva contraseña<input name="passwordConfirmation" type="password" minlength="12" maxlength="128" autocomplete="new-password" required></label><div class="admin-tool-actions"><button class="admin-tool-button primary" type="submit">Guardar contraseña</button><% if (!required) { %><a class="admin-tool-button secondary" href="/admin/dashboard">Cancelar</a><% } %></div></form></main><%- include("../../partials/admin-shell-end") %></body></html>
