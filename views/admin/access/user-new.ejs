<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Nuevo usuario | GATÓN DO</title><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/admin-utilities.css"><link rel="stylesheet" href="/css/admin.css"></head><body class="admin-shell-body"><%- include("../../partials/admin-shell-start") %>
<main class="admin-tool-page admin-access-page"><header class="admin-tool-heading"><a class="admin-tool-button secondary" href="/admin/users">Volver a usuarios</a></header>
<% if (error) { %><div class="admin-alert error"><%= error %></div><% } %><form method="post" action="/admin/users/new" class="admin-tool-card admin-access-form"><input type="hidden" name="_csrf" value="<%= adminCsrfToken %>">
<label>Nombre<input name="name" maxlength="120" required value="<%= formData?.name || '' %>"></label><label>Correo electrónico<input name="email" type="email" maxlength="191" required autocomplete="email" value="<%= formData?.email || '' %>"></label>
<div class="admin-access-grid"><label>Contraseña temporal<input name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required><small>Mínimo 12 caracteres. Nunca se muestra ni se envía por correo.</small></label><label>Confirmar contraseña<input name="passwordConfirmation" type="password" minlength="12" maxlength="128" autocomplete="new-password" required></label></div>
<fieldset><legend>Roles iniciales</legend><div class="admin-permission-grid"><% roles.forEach((role) => { %><label class="admin-permission-choice"><input type="checkbox" name="roleIds" value="<%= role.id %>" <%= (formData?.roleIds || []).includes(role.id) ? 'checked' : '' %>><span><strong><%= role.name %></strong><small><%= role.description %></small></span></label><% }) %></div><p class="admin-muted">Crea primero un rol si quieres limitar el acceso de esta cuenta.</p></fieldset>
<div class="admin-tool-actions"><button class="admin-tool-button primary" type="submit">Crear usuario</button><a class="admin-tool-button secondary" href="/admin/users">Cancelar</a></div></form></main><%- include("../../partials/admin-shell-end") %></body></html>
