<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cambiar contraseña | GATÓN DO</title><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/admin-utilities.css"><link rel="stylesheet" href="/css/admin.css"></head><body class="admin-shell-body"><%- include("../../partials/admin-shell-start") %>
<main class="admin-tool-page admin-access-page"><header class="admin-tool-heading"><a class="admin-tool-button secondary" href="/admin/users">Volver a usuarios</a></header>
<% if (error) { %><div class="admin-alert error"><%= error %></div><% } %><section class="admin-tool-card admin-access-form"><div class="admin-alert warning">Esta acción reemplaza la contraseña de la cuenta. La persona tendrá que establecer una clave propia al iniciar sesión.</div><form method="post" action="/admin/users/<%= user.id %>/password"><input type="hidden" name="_csrf" value="<%= adminCsrfToken %>"><label>Contraseña temporal nueva<input name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required><small>Mínimo 12 caracteres; no uses una clave ya compartida.</small></label><label>Confirmar contraseña<input name="passwordConfirmation" type="password" minlength="12" maxlength="128" autocomplete="new-password" required></label><div class="admin-tool-actions"><button class="admin-tool-button primary" type="submit">Guardar contraseña temporal</button><a class="admin-tool-button secondary" href="/admin/users">Cancelar</a></div></form></section></main><%- include("../../partials/admin-shell-end") %></body></html>
