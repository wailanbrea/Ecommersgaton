<% const activePath = adminCurrentPath || "/admin/dashboard"; %>
<div class="admin-shell" data-admin-shell>
  <aside class="admin-sidebar" id="admin-sidebar" aria-label="Navegación administrativa">
    <a class="admin-brand" href="/admin/dashboard" aria-label="GATÓN DO, ir al dashboard">
      <img src="/images/logo-gatondo-color.png" alt="GATÓN DO">
      <span class="admin-brand-name"><%= siteSettings?.brandName || 'GATÓN DO' %></span>
      <span class="admin-brand-caption">PANEL ADMINISTRATIVO</span>
    </a>

    <nav class="admin-navigation" aria-label="Secciones del panel">
      <p class="admin-nav-heading">Principal</p>
      <% if ((adminPermissions || []).includes('dashboard.view')) { %><a class="admin-nav-link <%= activePath === '/admin/dashboard' ? 'is-active' : '' %>" href="/admin/dashboard" aria-label="Dashboard" title="Dashboard" data-admin-link data-label="dashboard inicio">
        <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1z"/></svg></span><span class="admin-nav-label">Dashboard</span>
      </a><% } %>

      <p class="admin-nav-heading">Comercio</p>
      <% if ((adminPermissions || []).includes('sales.view')) { %><a class="admin-nav-link <%= activePath.startsWith('/admin/sales') ? 'is-active' : '' %>" href="/admin/sales" aria-label="Ventas y analítica" title="Ventas y analítica" data-admin-link data-label="ventas analítica estadísticas">
        <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19V9m8 10V5m8 14v-7"/><path d="M2 19h20"/></svg></span><span class="admin-nav-label">Ventas y analítica</span>
      </a><% } %>
      <% if ((adminPermissions || []).includes('products.view') || (adminPermissions || []).includes('products.create')) { %><a class="admin-nav-link <%= activePath.startsWith('/admin/products') ? 'is-active' : '' %>" href="/admin/products" aria-label="Productos" title="Productos" data-admin-link data-label="productos catálogo">
        <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5M3 16l9 5 9-5M12 8v5"/></svg></span><span class="admin-nav-label">Productos</span>
      </a><% } %>
      <% if ((adminPermissions || []).includes('inventory.view') || (adminPermissions || []).includes('inventory.import') || (adminPermissions || []).includes('inventory.export')) { %><a class="admin-nav-link <%= activePath.startsWith('/admin/inventory') ? 'is-active' : '' %>" href="/admin/inventory" aria-label="Inventario" title="Inventario" data-admin-link data-label="inventario stock existencias">
        <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="M3 12v5l9 5 9-5v-5M12 13v9"/></svg></span><span class="admin-nav-label">Inventario</span>
      </a><% } %>
      <% if ((adminPermissions || []).includes('categories.view') || (adminPermissions || []).includes('categories.create')) { %><a class="admin-nav-link <%= activePath.startsWith('/admin/categories') ? 'is-active' : '' %>" href="/admin/categories" aria-label="Categorías" title="Categorías" data-admin-link data-label="categorías colecciones">
        <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span><span class="admin-nav-label">Categorías</span>
      </a><% } %>
      <% if ((adminPermissions || []).includes('orders.view') || (adminPermissions || []).includes('orders.edit')) { %><a class="admin-nav-link <%= activePath.startsWith('/admin/orders') ? 'is-active' : '' %>" href="/admin/orders" aria-label="Pedidos" title="Pedidos" data-admin-link data-label="pedidos ventas">
        <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 4h2l2.2 11.1a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 1.9-1.4L22 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg></span><span class="admin-nav-label">Pedidos</span>
      </a><% } %>

      <p class="admin-nav-heading">Relación con clientes</p>
      <% if ((adminPermissions || []).includes('reviews.view') || (adminPermissions || []).includes('reviews.moderate')) { %><a class="admin-nav-link <%= activePath.startsWith('/admin/reviews') ? 'is-active' : '' %>" href="/admin/reviews" aria-label="Reseñas" title="Reseñas" data-admin-link data-label="reseñas opiniones">
        <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9z"/></svg></span><span class="admin-nav-label">Reseñas</span>
      </a><% } %>

      <p class="admin-nav-heading">Administración</p>
      <% if ((adminPermissions || []).includes('settings.view') || (adminPermissions || []).includes('settings.edit')) { %><a class="admin-nav-link <%= activePath.startsWith('/admin/settings') ? 'is-active' : '' %>" href="/admin/settings" aria-label="Configuración" title="Configuración" data-admin-link data-label="configuración sitio">
        <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1a1.7 1.7 0 1 1-2.4 2.4l-.1-.1a1.7 1.7 0 0 0-2.9 1.2v.2a1.7 1.7 0 1 1-3.4 0v-.2a1.7 1.7 0 0 0-2.9-1.2l-.1.1a1.7 1.7 0 1 1-2.4-2.4l.1-.1A1.7 1.7 0 0 0 4.2 12h-.2a1.7 1.7 0 1 1 0-3.4h.2a1.7 1.7 0 0 0 1.2-2.9l-.1-.1a1.7 1.7 0 1 1 2.4-2.4l.1.1a1.7 1.7 0 0 0 2.9-1.2v-.2a1.7 1.7 0 1 1 3.4 0v.2a1.7 1.7 0 0 0 2.9 1.2l.1-.1a1.7 1.7 0 1 1 2.4 2.4l-.1.1a1.7 1.7 0 0 0 1.2 2.9h.2a1.7 1.7 0 1 1 0 3.4h-.2a1.7 1.7 0 0 0-1.2 2.9Z"/></svg></span><span class="admin-nav-label">Configuración</span>
      </a><% } %>
      <% if ((adminPermissions || []).includes('users.manage')) { %><a class="admin-nav-link <%= activePath.startsWith('/admin/users') ? 'is-active' : '' %>" href="/admin/users" aria-label="Usuarios" title="Usuarios" data-admin-link data-label="usuarios administradores cuentas">
        <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="4"/><path d="M2 21v-2a7 7 0 0 1 14 0v2M17 4a4 4 0 0 1 0 8m2 3a5 5 0 0 1 3 4v2"/></svg></span><span class="admin-nav-label">Usuarios</span>
      </a><% } %>
      <% if ((adminPermissions || []).includes('roles.manage')) { %><a class="admin-nav-link <%= activePath.startsWith('/admin/roles') ? 'is-active' : '' %>" href="/admin/roles" aria-label="Roles y permisos" title="Roles y permisos" data-admin-link data-label="roles permisos accesos">
        <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 20 6v5c0 5-3.4 8.3-8 10-4.6-1.7-8-5-8-10V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></span><span class="admin-nav-label">Roles y permisos</span>
      </a><% } %>
      <% if ((adminPermissions || []).includes('account.password.change')) { %><a class="admin-nav-link <%= activePath.startsWith('/admin/account/password') ? 'is-active' : '' %>" href="/admin/account/password" aria-label="Mi contraseña" title="Mi contraseña" data-admin-link data-label="mi contraseña cambiar clave">
        <span class="admin-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 1 1 8 0v3M12 14v3"/></svg></span><span class="admin-nav-label">Mi contraseña</span>
      </a><% } %>
    </nav>

    <div class="admin-sidebar-footer">
      <a class="admin-store-link" href="/" target="_blank" rel="noopener"><span aria-hidden="true">↗</span><span class="admin-nav-label">Ver tienda online</span></a>
      <span class="admin-sidebar-note">Joyas que cuentan tu historia</span>
    </div>
  </aside>

  <button class="admin-sidebar-overlay" type="button" data-sidebar-overlay aria-label="Cerrar menú" tabindex="-1"></button>

  <div class="admin-workspace">
    <header class="admin-topbar">
      <button class="admin-menu-toggle" type="button" data-sidebar-toggle aria-controls="admin-sidebar" aria-expanded="false" aria-label="Abrir menú">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div class="admin-topbar-title"><span>Panel administrativo</span><h1><%= adminPageTitle || 'GATÓN DO' %></h1></div>

      <div class="admin-search-wrap" data-admin-search-wrap>
        <svg class="admin-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg>
        <input type="search" class="admin-search" data-admin-search placeholder="Buscar una sección..." aria-label="Buscar una sección del panel" autocomplete="off">
        <div class="admin-search-results" data-admin-search-results hidden role="listbox" aria-label="Secciones encontradas"></div>
      </div>

      <div class="admin-user"><span class="admin-user-avatar" aria-hidden="true"><%= String(currentAdminEmail || 'A').slice(0,1).toUpperCase() %></span><span class="admin-user-email"><%= currentAdminEmail || 'Administrador' %></span><% if ((adminPermissions || []).includes('account.password.change')) { %><a class="admin-account-link" href="/admin/account/password">Mi contraseña</a><% } %></div>
      <form action="/admin/logout" method="post" class="admin-logout-form"><input type="hidden" name="_csrf" value="<%= adminCsrfToken %>"><button class="admin-logout" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3"/><path d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"/></svg><span>Cerrar sesión</span></button></form>
    </header>
    <div class="admin-page-slot">
