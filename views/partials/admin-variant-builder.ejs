<div class="rounded-2xl border border-[#d9c8ae] bg-[#fbf8f2] p-5 mb-5" data-variant-builder>
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <div>
      <h4 class="text-base font-semibold text-stone-900">Constructor rápido de combinaciones</h4>
      <p class="text-xs text-stone-600 mt-1">Agrega todos los atributos que necesites (Color, Tamaño, Tipo de metal, Grosor...) con los valores que quieras. Luego genera la tabla compacta y quita con un clic las combinaciones que no existan.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-medium text-stone-600" data-vb-summary></span>
      <button type="button" data-vb-add-attr class="vb-btn vb-btn-secondary">+ Agregar otro atributo</button>
    </div>
  </div>

  <div class="vb-attr-grid" data-vb-attrs></div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-4 items-end">
    <div>
      <label class="block text-xs font-medium text-stone-600 mb-1">Precio inicial por combinación (RD$)</label>
      <input type="text" inputmode="decimal" data-vb-default-price placeholder="Usa el precio base si se deja vacío" class="w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm">
    </div>
    <div>
      <label class="block text-xs font-medium text-stone-600 mb-1">Stock inicial por combinación</label>
      <input type="number" min="0" data-vb-default-stock value="5" class="w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm">
    </div>
    <div class="vb-actions-row">
      <button type="button" data-vb-generate class="vb-btn vb-btn-primary">
        Generar combinaciones
      </button>
      <button type="button" data-vb-apply-all class="vb-btn vb-btn-secondary">
        Aplicar a todas
      </button>
    </div>
  </div>
</div>
