<header class="bg-white border-b border-stone-200">
  <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-xs uppercase tracking-[0.35em] text-stone-500">Panel Administrativo</p>
      <h1 class="text-2xl font-semibold text-stone-900">GATON DO</h1>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <button type="button" onclick="history.length > 1 ? history.back() : location.href='/admin/dashboard'" class="rounded-xl bg-white border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-50">
        Volver
      </button>
      <a href="/admin/dashboard" class="rounded-xl bg-stone-100 text-stone-800 px-4 py-2 text-sm font-medium hover:bg-stone-200">
        Dashboard
      </a>
      <span class="text-sm text-stone-600"><%= currentAdminEmail || "" %></span>
      <form action="/admin/logout" method="post">
        <button class="rounded-xl bg-stone-900 text-white px-4 py-2 text-sm hover:bg-stone-800">
          Cerrar sesión
        </button>
      </form>
    </div>
  </div>
</header>
