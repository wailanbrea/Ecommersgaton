<%
  function footer10Text(value, fallback = "") {
    return String(value || fallback || "")
      .replace(/&aacute;/g, "á").replace(/&eacute;/g, "é").replace(/&iacute;/g, "í").replace(/&oacute;/g, "ó").replace(/&uacute;/g, "ú")
      .replace(/&ntilde;/g, "ñ").replace(/&amp;/g, "&")
      .replace(/intenci�n/gi, "intención").replace(/joyer�a/gi, "joyería").replace(/fraganc�as/gi, "fragancias");
  }

  const footerBrand = footer10Text(siteSettings?.brandName, "GATON DO");
  const instagramUrl = safePublicUrl(siteSettings?.instagramUrl || siteSettings?.instagram, "https://www.instagram.com/gaton.do");
  const tiktokUrl = safePublicUrl(siteSettings?.tiktokUrl || siteSettings?.tiktok, "https://www.tiktok.com/@gaton.do");
  const facebookUrl = safePublicUrl(siteSettings?.facebookUrl || siteSettings?.facebook, "https://www.facebook.com");
  const linktreeUrl = safePublicUrl(siteSettings?.linktreeUrl || siteSettings?.linktree);
  const whatsappDigits = String(siteSettings?.whatsapp || siteSettings?.whatsappNumber || siteSettings?.phone || "").replace(/\D/g, "");
  const whatsappUrl = whatsappDigits ? `https://wa.me/${whatsappDigits}` : "";
%>

<footer class="ref10-footer">
  <div class="ref10-footer-inner">
    <div class="ref10-footer-brand">
      <a href="/" aria-label="<%= footerBrand %>"><img src="<%= safePublicUrl(siteSettings?.footerLogoUrl, '/images/logo-gatondo-white.png?v=2026-logos') %>" alt="<%= footerBrand %>"></a>
      <p><%= footer10Text(siteSettings?.slogan || siteSettings?.footerSlogan, "Joyas con intención. Hechas a mano en República Dominicana.") %></p>
    </div>

    <nav class="ref10-footer-col" aria-label="Tienda">
      <h3>Tienda</h3>
      <a href="/shop">Joyería</a>
      <a href="/shop?category=fragancias">Fragancias</a>
      <a href="/shop?q=personalizado">Personalizados</a>
    </nav>

    <nav class="ref10-footer-col" aria-label="GATON">
      <h3>GATON</h3>
      <a href="/#historia">Historia</a>
      <a href="/#clientes">Clientes</a>
      <a href="/#contacto">Contacto</a>
    </nav>

    <nav class="ref10-footer-col" aria-label="Síguenos">
      <h3>Síguenos</h3>
      <% if (instagramUrl) { %>
        <a href="<%= instagramUrl %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          <span>Instagram</span>
        </a>
      <% } %>
      <% if (tiktokUrl) { %>
        <a href="<%= tiktokUrl %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
          <span>TikTok</span>
        </a>
      <% } %>
      <% if (facebookUrl) { %>
        <a href="<%= facebookUrl %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          <span>Facebook</span>
        </a>
      <% } %>
      <% if (whatsappUrl) { %>
        <a href="<%= whatsappUrl %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          <span>WhatsApp</span>
        </a>
      <% } %>
      <% if (linktreeUrl) { %>
        <a href="<%= linktreeUrl %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span>Linktree</span>
        </a>
      <% } %>
    </nav>
  </div>

  <div class="ref10-footer-bottom">
    <span>© 2024–<%= new Date().getFullYear() %> <%= footerBrand %> · Personalización · Joyería · Fragancias</span>
    <span><%= siteSettings?.locationText %></span>
  </div>
</footer>

<%- include("basket-panel") %>
