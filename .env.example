# Copiar a .env.local. No usar estos valores por defecto en el servidor.
NODE_ENV=development
HOST=127.0.0.1
PORT=8081
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=gatondo_app_local
MYSQL_PASSWORD=replace-with-a-local-random-password
MYSQL_DATABASE=gatondo_local_mysql
MYSQL_POOL_SIZE=10
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_NAME=Administrador local
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-a-long-unique-password
SITE_BRAND_NAME=GATON DO
SITE_SLOGAN=Joyas que cuentan tu historia

# Solo herramientas de importación/consulta, no las usa la aplicación web.
MONGO_SOURCE_URI=mongodb://127.0.0.1:27017/gatondo_local?retryWrites=true&w=majority